# Кладка из отдельных боксов-камней: якоря рядов вразбежку, стена с подрезкой
# торцов `clip`, угловые квойны. Стена собирается в локальной системе (x вдоль
# стены, центр в 0, z наружу) и ставится на место внешним transform; проёмы —
# удалением якорей маской до вызова stone_wall. Группы: stone, cut (крышки срезов).

import lib.parts

def bond_anchors(len: f32, cols: int, n_rows: int, course_h: f32, y0: f32, z: f32) -> (out: geo<points>) {
    """Якоря кладки вразбежку в локальной системе стены (x вдоль, центр в 0): модель
    строк — точки-ряды (`mesh_line` по y), делегат — `foreach` по ним (§5.4): ряд
    генерируется с запасом на блок за каждый край (шаг pitch = len / cols), нечётные ряды
    сдвинуты на полшага (перевязка), номер ряда — `@piece_index`, высота ряда — из `@P` модели."""
    pitch = len / f32(cols)
    rows = mesh_line(count = n_rows, length = f32(n_rows - 1) * course_h, dir = (0, 1, 0))
    out = foreach row in rows {
        odd = f32(@piece_index % 2)
        r0 = mesh_line(count = cols + 2, length = f32(cols + 1) * pitch, dir = (1, 0, 0))
        row = transform(r0, translate = vec3(0.0 - len * 0.5 - pitch * 0.5 + odd * pitch * 0.5, y0 + course_h * 0.5 + dot(value(@P, on = row), (0, 1, 0)), z))
    }
}

def stone_wall(rows: geo<points>, len: f32, blk: vec3, rng: rng) -> (out: geo<mesh>) {
    """Кладка одной стены в локальной системе (x вдоль стены, центр в 0): ряды якорей
    → блок с центром за краем не кладётся → @scale/@variant (три длины blk × 1 / 1.1 / 1.2 — не длиннее шага ряда, чтобы соседи не сливались в плиту)
    → почти серый @tint → джиттер → realize → подрезка торцов плоскостями x = ±len/2
    (`clip`, крышки срезов в группе `cut`). Ставится на место внешним transform."""
    a0 = parts.cbox(size = blk, k = 0.16)
    a1 = parts.cbox(size = blk * vec3(1.1, 1, 1), k = 0.16)
    a2 = parts.cbox(size = blk * vec3(1.2, 1, 1), k = 0.16)
    kept = delete(rows, where = abs(dot(@P, (1, 0, 0))) > len * 0.5 + 0.02)
    p1 = set(kept, "scale", random(lo = 0.92, hi = 1.08, rng = split_rng(rng, key = "scale")))
    p2 = set(p1, "variant", random_int(n = 3, rng = split_rng(rng, key = "var")))
    shade = random(lo = 0.7, hi = 1.25, rng = split_rng(rng, key = "tint"))
    p3 = set(p2, "tint", vec3(shade * 1.04, shade, shade * 0.96))
    p4 = set_position(p3, offset = random_vec(lo = vec3(-0.03, -0.01, -0.01), hi = vec3(0.03, 0.01, 0.07), rng = split_rng(rng, key = "jitter")))
    m = realize(instance_on_points(p4, source = a0, variants = [a0, a1, a2]))
    c1 = clip(m, origin = vec3(0.0 - len * 0.5, 0, 0), normal = vec3(1, 0, 0), cap_group = "cut")
    out = clip(c1, origin = vec3(len * 0.5, 0, 0), normal = vec3(-1, 0, 0), cap_group = "cut")
}

def quoin_corner(sx: f32, sz: f32, w: f32, d: f32, h: f32, L: f32, W: f32, p: f32, y: f32, q: f32) -> (out: geo<mesh>) {
    """Один ряд угловой колонны (сечение «в 1.5 блока», (L+W)×(L+W)) на углу со
    знаками sx/sz: угловой блок a (q = 0 — длиной вдоль X, q = 1 — вдоль Z),
    примыкающий блок b перпендикулярного плеча — его торец стыкуется с длинной
    гранью углового, — и половинка hlf, достраивающая ложковое плечо до квадратного
    сечения. Грани колонны выпущены на p за плоскость сердцевины дома."""
    da = q * (L - W)
    sa = da * 0.5
    db = q * (W + L) * 0.5
    a = transform(parts.cbox(size = vec3(L - da, h, W + da), k = 0.12), translate = vec3(sx * (w * 0.5 + p - L * 0.5 + sa), y, sz * (d * 0.5 + p - W * 0.5 - sa)))
    b = transform(parts.cbox(size = vec3(W + da, h, L - da), k = 0.12), translate = vec3(sx * (w * 0.5 + p - W * 0.5 - db), y, sz * (d * 0.5 + p - W - L * 0.5 + db)))
    hlf = transform(parts.cbox(size = vec3(W, h, W), k = 0.12), translate = vec3(sx * (w * 0.5 + p - W * 0.5 - L * (1.0 - q)), y, sz * (d * 0.5 + p - W * 0.5 - L * q)))
    out = merge(a, b, hlf)
}

def quoin_course(w: f32, d: f32, h: f32, L: f32, W: f32, p: f32, y: f32, q: f32) -> (out: geo<mesh>) {
    """Ряд квойнов на четырёх углах дома w×d на высоте y (центр ряда). Группа stone."""
    c1 = quoin_corner(sx = 1.0, sz = 1.0, w = w, d = d, h = h, L = L, W = W, p = p, y = y, q = q)
    c2 = quoin_corner(sx = 1.0, sz = 0.0 - 1.0, w = w, d = d, h = h, L = L, W = W, p = p, y = y, q = q)
    c3 = quoin_corner(sx = 0.0 - 1.0, sz = 1.0, w = w, d = d, h = h, L = L, W = W, p = p, y = y, q = q)
    c4 = quoin_corner(sx = 0.0 - 1.0, sz = 0.0 - 1.0, w = w, d = d, h = h, L = L, W = W, p = p, y = y, q = q)
    out = mark(merge(c1, c2, c3, c4), "stone", where = true, domain = faces)
}

def quoin_stack(w: f32, d: f32, n_rows: int, course_h: f32) -> (out: geo<mesh>) {
    """Угловая кладка дома w×d (квойны): колонны сечением «в 1.5 блока» на четырёх
    углах, n_rows рядов с шагом course_h. Направление углового блока чередуется по
    рядам — торец плеча одного ряда стыкуется с длинной гранью следующего (перевязка
    угла, как у кирпичного столба), заодно квойны прячут торцы рядов кладки стен.
    Ряд 0 — угловой длиной вдоль X. Группа stone."""
    L = 0.62
    W = 0.32
    p = 0.2
    h = course_h * 0.9
    row0 = quoin_course(w = w, d = d, h = h, L = L, W = W, p = p, y = course_h * 0.5, q = 0.0)
    out = repeat (row0, iterations = n_rows - 1) |acc| {
        k = f32(@iteration) + 1.0
        q = k - 2.0 * floor(k * 0.5)
        course = quoin_course(w = w, d = d, h = h, L = L, W = W, p = p, y = (k + 0.5) * course_h, q = q)
        acc = merge(acc, course)
    }
}
