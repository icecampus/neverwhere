# Шестигранный эркер-ризалит 2-го этажа (нижняя часть башни, опирающаяся на консольный сход):
# - Ступенчатый шестигранный каменный консольный сход (corbel) под эркером: верх на f1_top;
# - Нижний шестигранный пояс — тот же разрез, что межэтажный карниз дома (отметка и профиль);
# - Шестигранный кирпичный корпус 2-го этажа;
# - Арочные окна stone_arch_window: по одному в центре трёх выступающих граней;
# - Каменные угловые колоннетты на видимых рёбрах шестигранника;
# - Верхний поясок под часовым ярусом на отметке f2_top.
import lib.ironwork
import lib.architecture
import spire_house.common as common
import spire_house.windows as windows

def bay_window(facade_z: f32, f1_top: f32, b1_top: f32, f2_top: f32, f2_y: f32, tower_w: f32 = 2.50, tower_z: f32 = 2.60, ris_w: f32 = 2.40, ris_p: f32 = 1.25) -> (out: geo<mesh>) {
    """Шестигранный эркер второго этажа (основание башни):
    башня заканчивается на втором этаже и опирается на шестигранный консольный сход."""
    r_in = tower_w * 0.5
    r_out = r_in * 1.1547
    belt_h = b1_top - f1_top
    # 1. Консоль под эркером: верх на низе межэтажного карниза, кирпич 2-го этажа выше пояса
    corb0 = common.hexa_corbel(y_top = f1_top, h = 0.85, r_top = r_out)
    tower_corbel = transform(corb0, translate = vec3(0, 0, tower_z))
    # 2. Нижний пояс башни — тот же разрез, что belt дома (0.22 / 0.30 от грани)
    bay_belt0 = common.hexa_belt(y = f1_top, h = belt_h, r = r_out)
    bay_belt = transform(bay_belt0, translate = vec3(0, 0, tower_z))
    # 3. Шестигранный кирпичный корпус 2-го этажа (y: b1_top -> f2_top)
    body2 = common.hexa_frustum(y0 = b1_top, y1 = f2_top, r0 = r_out, r1 = r_out, grp = "brick")
    f2_body = transform(body2, translate = vec3(0, 0, tower_z))
    # 4. Арочные окна 2-го этажа: по одному в центре каждой из трёх выступающих граней
    win2 = windows.stone_arch_window(w = 0.46, h = 2.15)
    w2_base = transform(win2, translate = vec3(0, f2_y, r_in + 0.02))
    w2_f = transform(w2_base, translate = vec3(0, 0, tower_z))
    w2_r = transform(transform(w2_base, rotate = vec3(0, 60, 0)), translate = vec3(0, 0, tower_z))
    w2_l = transform(transform(w2_base, rotate = vec3(0, 300, 0)), translate = vec3(0, 0, tower_z))
    f2_wins = merge(w2_f, w2_r, w2_l)
    # 5. Угловые каменные колоннетты на видимых рёбрах шестигранника 2-го этажа
    shaft2 = architecture.regroup(ironwork.spool(p0 = vec3(0, b1_top, 0), p1 = vec3(0, f2_top - 0.05, 0), r0 = 0.065, r1 = 0.055, sides = 8), grp = "stone")
    sh2_base = transform(shaft2, translate = vec3(0, 0, r_out))
    sh2_r = transform(sh2_base, rotate = vec3(0, 30, 0))
    sh2_l = transform(sh2_base, rotate = vec3(0, 330, 0))
    sh2_wr = transform(sh2_base, rotate = vec3(0, 90, 0))
    sh2_wl = transform(sh2_base, rotate = vec3(0, 270, 0))
    shafts_2 = transform(merge(sh2_r, sh2_l, sh2_wr, sh2_wl), translate = vec3(0, 0, tower_z))
    # 6. Верхний переходный поясок под часовым ярусом
    top_belt0 = common.hexa_belt(y = f2_top - 0.18, h = 0.20, r = r_out, over_lo = 0.04, over_hi = 0.09)
    bay_top_belt = transform(top_belt0, translate = vec3(0, 0, tower_z))
    out = merge(tower_corbel, bay_belt, f2_body, f2_wins, shafts_2, bay_top_belt)
}
