# Мансардная крыша: настил-пирамида, 4 черепичных ската со смещением и нахлёстом,
# коньковые уголки по рёбрам вальм, кованая решётка палубы и угловые пики.
import lib.parts
import lib.ironwork
import spire_house.common as common

def mansard_tile_slope(len_bot: f32, len_top: f32, slope_len: f32, n_rows: int, rng: rng) -> (out: geo<mesh>) {
    """Черепичный скат мансарды рядами вразбежку, как кирпичная кладка:
    общая колоночная сетка с шагом pu, нечётный ряд сдвинут на полплитки (pu/2)
    относительно предыдущего. Ширина ряда сужается к палубе — лишние якоря
    по бокам снимаются, чтобы не пересчитывать сетку и не сбивать перевязку.
    Нахлёст — подъём ряда по Y; @tint — лёгкая тональная вариация."""
    pv = slope_len / f32(n_rows)
    tw = 0.28
    tl = pv + 0.09
    th = 0.035
    pu = 0.31
    tile = compute_normals(box(size = vec3(tw, th, tl)), mode = flat)
    n_cols = int(len_bot / pu)
    empty = mesh_line(count = 0, length = 0.0)
    anchors_all = repeat (empty, iterations = n_rows) |acc| {
        k = f32(@iteration)
        odd = f32(@iteration % 2)
        vk = k * pv + pv * 0.35
        row0 = mesh_line(count = n_cols + 2, length = f32(n_cols + 1) * pu, dir = (1, 0, 0))
        row = transform(row0, translate = vec3(0.0 - len_bot * 0.5 - pu * 0.5 + odd * pu * 0.5, th * 0.5 + k * 0.010, 0.0 - vk))
        acc = merge(acc, row)
    }
    # Полуширина ската на этой высоте (трапеция), с запасом на полплитки у вальм.
    anchors = delete(anchors_all, where = abs(dot(@P, (1, 0, 0))) > (len_bot - (len_bot - len_top) * ((0.0 - dot(@P, (0, 0, 1))) / slope_len) - 0.28) * 0.5)
    t_jit = set_position(anchors, offset = random_vec(lo = vec3(-0.005, 0, -0.005), hi = vec3(0.005, 0.003, 0.005), rng = split_rng(rng, key = "jit")))
    shade = random(lo = 0.80, hi = 1.20, rng = split_rng(rng, key = "tint"))
    p_tint = set(t_jit, "tint", vec3(shade * 0.97, shade, shade * 1.05))
    out = mark(realize(instance_on_points(p_tint, source = tile)), "roof", where = true, domain = faces)
}

def mansard(hw0: f32, hd0: f32, hw1: f32, hd1: f32, h: f32) -> (out: geo<mesh>) {
    """Мансардная основа под настил: усечённая пирамида от прямоугольника 2hw0×2hd0 к 2hw1×2hd1.
    Вертикальный sweep: X профиля → мир +Z, Y профиля → мир +X, поэтому в @profile_scale
    глубина и ширина стоят наоборот. Поворот 45° — грани по осям, не ромб."""
    path0 = mesh_line(count = 2, length = h, dir = (0, 1, 0))
    path = set(path0, "profile_scale", @index == 0 ? vec2(hd0 * 1.41421, hw0 * 1.41421) : vec2(hd1 * 1.41421, hw1 * 1.41421))
    body = sweep(path, profile = transform(circle(sides = 4, radius = 1.0), rotate = vec3(0, 0, 45)))
    out = mark(compute_normals(body, mode = flat), "roof", where = true, domain = faces)
}

def hip_caps(p0: vec3, p1: vec3, rng: rng) -> (out: geo<mesh>) {
    """Конёк вальмы: согнутые черепичные уголки вдоль ребра p0→p1, каждый
    накрывает предыдущий. Два крыла раскрыты чуть положе скатов (~84°), чтобы
    лежать сверху полевой черепицы, а не в ендове ребра. Смещение вдоль биссектрисы
    (+Y) поднимает уголок над настилом. Низ и верх подрезаются плоскостями карниза
    и палубы. Локально ребро вдоль +Z; в мир — pitch, yaw."""
    d = p1 - p0
    len = length(d)
    horiz = length(vec3(dot(d, (1, 0, 0)), 0.0, dot(d, (0, 0, 1))))
    pitch = 0.0 - degrees(atan2(dot(d, (0, 1, 0)), horiz))
    yaw = degrees(atan2(dot(d, (1, 0, 0)), dot(d, (0, 0, 1))))
    w = 0.42
    th = 0.040
    cl = 0.46
    half = 42.0
    right = transform(parts.piece(size = vec3(w, th, cl), pos = vec3(w * 0.5, 0, 0), grp = "roof"), rotate = vec3(0, 0, 0.0 - half))
    left = transform(parts.piece(size = vec3(w, th, cl), pos = vec3(0.0 - w * 0.5, 0, 0), grp = "roof"), rotate = vec3(0, 0, half))
    cap = merge(left, right)
    n = 10
    span = len - 0.18
    pts0 = mesh_line(count = n, length = span, dir = (0, 0, 1))
    pts1 = set_position(pts0, offset = vec3(0.0, 0.12 + f32(@index) * 0.008, 0.20))
    shade = random(lo = 0.82, hi = 1.18, rng = split_rng(rng, key = "tint"))
    pts = set(pts1, "tint", vec3(shade * 0.97, shade, shade * 1.05))
    local = mark(realize(instance_on_points(pts, source = cap)), "roof", where = true, domain = faces)
    pitched = transform(local, rotate = vec3(pitch, 0, 0))
    world = transform(pitched, rotate = vec3(0, yaw, 0), translate = p0)
    # Подрезка по горизонтальным плоскостям карниза (y = p0) и палубы (y = p1).
    lo = clip(world, origin = p0, normal = vec3(0, 1, 0), cap_group = "roof")
    hi = clip(lo, origin = p1, normal = vec3(0, -1, 0), cap_group = "roof")
    out = compute_normals(mark(hi, "roof", where = true, domain = faces), mode = flat)
}

def mansard_roof(width: f32, depth: f32, crown_top: f32, roof_h: f32, deck_hw: f32, deck_hd: f32, rng: rng) -> (out: geo<mesh>) {
    """Мансардная крыша здания:
    - Пирамидальное основание;
    - 4 черепичных ската, ряды вразбежку на полплитки (угол 63.435°);
    - Коньковые уголки (hip caps) по 4 угловым рёбрам вальм;
    - Кованая ограда палубы (чугунный гребень);
    - Угловые карнизные финиалы-пики."""
    eave_hw = width * 0.5 + 0.35
    eave_hd = depth * 0.5 + 0.35
    deck_y = crown_top + roof_h
    roof_deck = transform(mansard(hw0 = eave_hw, hd0 = eave_hd, hw1 = deck_hw, hd1 = deck_hd, h = roof_h), translate = vec3(0, crown_top, 0))
    slope_len = 2.5715
    # 4 черепичных ската
    slope_f0 = mansard_tile_slope(len_bot = eave_hw * 2.0, len_top = deck_hw * 2.0, slope_len = slope_len, n_rows = 9, rng = split_rng(rng, key = "tiles_f"))
    slope_f = transform(transform(slope_f0, rotate = vec3(63.435, 0, 0)), translate = vec3(0, crown_top, eave_hd))
    slope_b0 = mansard_tile_slope(len_bot = eave_hw * 2.0, len_top = deck_hw * 2.0, slope_len = slope_len, n_rows = 9, rng = split_rng(rng, key = "slope_b"))
    slope_b = transform(transform(transform(slope_b0, rotate = vec3(63.435, 0, 0)), translate = vec3(0, crown_top, eave_hd)), rotate = vec3(0, 180, 0))
    slope_r0 = mansard_tile_slope(len_bot = eave_hd * 2.0, len_top = deck_hd * 2.0, slope_len = slope_len, n_rows = 9, rng = split_rng(rng, key = "slope_r"))
    slope_r = transform(transform(transform(slope_r0, rotate = vec3(63.435, 0, 0)), translate = vec3(0, crown_top, eave_hw)), rotate = vec3(0, 90, 0))
    slope_l0 = mansard_tile_slope(len_bot = eave_hd * 2.0, len_top = deck_hd * 2.0, slope_len = slope_len, n_rows = 9, rng = split_rng(rng, key = "slope_l"))
    slope_l = transform(transform(transform(slope_l0, rotate = vec3(63.435, 0, 0)), translate = vec3(0, crown_top, eave_hw)), rotate = vec3(0, 270, 0))
    # Коньковые уголки по рёбрам вальм
    hip_fr = hip_caps(p0 = vec3(eave_hw, crown_top, eave_hd), p1 = vec3(deck_hw, deck_y, deck_hd), rng = split_rng(rng, key = "hip_fr"))
    hip_fl = hip_caps(p0 = vec3(0.0 - eave_hw, crown_top, eave_hd), p1 = vec3(0.0 - deck_hw, deck_y, deck_hd), rng = split_rng(rng, key = "hip_fl"))
    hip_br = hip_caps(p0 = vec3(eave_hw, crown_top, 0.0 - eave_hd), p1 = vec3(deck_hw, deck_y, 0.0 - deck_hd), rng = split_rng(rng, key = "hip_br"))
    hip_bl = hip_caps(p0 = vec3(0.0 - eave_hw, crown_top, 0.0 - eave_hd), p1 = vec3(0.0 - deck_hw, deck_y, 0.0 - deck_hd), rng = split_rng(rng, key = "hip_bl"))
    hips = merge(hip_fr, hip_fl, hip_br, hip_bl)
    # Решётка палубы
    rail_h = 0.95
    rail_bk = transform(common.rail_run(len = deck_hw * 2.0 - 0.3, h = rail_h), translate = vec3(0, deck_y, 0.0 - deck_hd + 0.15))
    rail_rt = transform(transform(common.rail_run(len = deck_hd * 2.0 - 0.3, h = rail_h), rotate = vec3(0, 90, 0)), translate = vec3(deck_hw - 0.15, deck_y, 0))
    rail_lt = transform(transform(common.rail_run(len = deck_hd * 2.0 - 0.3, h = rail_h), rotate = vec3(0, 90, 0)), translate = vec3(0.0 - deck_hw + 0.15, deck_y, 0))
    # Угловые пики-финиалы карниза
    eave_fin = merge(parts.piece(size = vec3(0.07, 0.3, 0.07), pos = vec3(0, 0.15, 0), grp = "iron"), ironwork.spearhead(base = vec3(0, 0.3, 0), h = 0.4, w = 0.12))
    eave_fins = merge(transform(eave_fin, translate = vec3(eave_hw - 0.10, crown_top - 0.05, eave_hd - 0.10)), transform(eave_fin, translate = vec3(0.0 - eave_hw + 0.10, crown_top - 0.05, eave_hd - 0.10)), transform(eave_fin, translate = vec3(eave_hw - 0.10, crown_top - 0.05, 0.0 - eave_hd + 0.10)), transform(eave_fin, translate = vec3(0.0 - eave_hw + 0.10, crown_top - 0.05, 0.0 - eave_hd + 0.10)))
    out = merge(roof_deck, slope_f, slope_b, slope_r, slope_l, hips, rail_bk, rail_rt, rail_lt, eave_fins)
}
