# Общие вспомогательные элементы и геометрические примитивы для spire_house:
# карнизы, дентикулы, ступенчатый корбель, восьмигранные тела, люкарны шпиля и решётки.
import lib.parts
import lib.blockwork

def to_group(g: geo<mesh>, src: string, dst: string) -> (out: geo<mesh>) {
    """Переметить грани из группы src в dst (ingroup-маска, затем снять src)."""
    out = unmark(mark(g, dst, where = ingroup(src), domain = faces), src)
}

def brick_prism(w: f32, d: f32, h: f32, y0: f32) -> (out: geo<mesh>) {
    """Прямой объём w×d высотой h, низ на y0. Без фаски: `piece`/`cbox`
    скос считает от min(размера), и на этаже это ~0.12·h ≈ 40 см — грани
    визуально загибаются внутрь у карниза и цоколя. Сердцевина под облицовкой
    brick_rows — группа mortar (раствор в швах между кирпичами)."""
    body = compute_normals(box(size = vec3(w, h, d)), mode = flat)
    out = mark(transform(body, translate = vec3(0, y0 + h * 0.5, 0)), "mortar", where = true, domain = faces)
}

def brick_rows(len: f32, h: f32) -> (out: geo<points>) {
    """Якоря мелкой кирпичной кладки вразбежку: ложок L=0.17, ряд 0.12
    (квойн 0.62×~0.46 — в 3.5–4 раза крупнее). Локально: x вдоль, низ y=0,
    лицо +Z, вынос z=0.03. Проёмы не дырявят якоря: сплошной ряд, затем
    clip_arch_hole / clip_circle_hole подрезает кирпичи по контуру."""
    L = 0.17
    ch = 0.12
    n_rows = int(h / ch)
    out = blockwork.coursed_wall_anchors(S = len, n_rows = n_rows, course_h = ch, y0 = 0.0, z = 0.03, L = L, g0 = 0.008)
}

def brick_from_rows(rows: geo<points>, rng: rng) -> (out: geo<mesh>) {
    """Мелкие кирпичи по якорям brick_rows: ¼/½/¾/полный ложок, лёгкий @tint
    и джиттер, группа brick. Фаска k=0.14 — светлая кромка edge."""
    L = 0.17
    bh = 0.104
    t = 0.046
    a0 = parts.cbox(size = vec3(L * 0.25, bh, t), k = 0.14)
    a1 = parts.cbox(size = vec3(L * 0.5, bh, t), k = 0.14)
    a2 = parts.cbox(size = vec3(L * 0.75, bh, t), k = 0.14)
    a3 = parts.cbox(size = vec3(L, bh, t), k = 0.14)
    shade = random(lo = 0.84, hi = 1.16, rng = split_rng(rng, key = "tint"))
    p1 = set(rows, "tint", vec3(shade * 1.06, shade * 0.98, shade * 0.92))
    p2 = set_position(p1, offset = random_vec(lo = vec3(-0.003, -0.002, -0.003), hi = vec3(0.003, 0.002, 0.006), rng = split_rng(rng, key = "jit")))
    out = mark(realize(instance_on_points(p2, source = a3, variants = [a0, a1, a2, a3])), "brick", where = true, domain = faces)
}

def clip_wedge_out(g: geo<mesh>, cx: f32, cy: f32, R: f32, deg0: f32, deg1: f32) -> (out: geo<mesh>) {
    """Сектор [deg0, deg1] снаружи окружности (cx, cy, R): между лучами и за
    касательной на биссектрисе. Крышка среза — brick (торец подрезанного ложка)."""
    th0 = radians(deg0)
    th1 = radians(deg1)
    c0 = cos(th0)
    s0 = sin(th0)
    c1 = cos(th1)
    s1 = sin(th1)
    g1 = clip(g, origin = vec3(cx, cy, 0), normal = vec3(0.0 - s0, c0, 0))
    g2 = clip(g1, origin = vec3(cx, cy, 0), normal = vec3(s1, 0.0 - c1, 0))
    thm = (th0 + th1) * 0.5
    nmx = cos(thm)
    nmy = sin(thm)
    out = clip(g2, origin = vec3(cx + R * nmx, cy + R * nmy, 0), normal = vec3(nmx, nmy, 0), cap_group = "brick")
}

def clip_arch_hole(g: geo<mesh>, cx: f32, y_bot: f32, win_w: f32, win_h: f32, bar: f32, gap: f32) -> (out: geo<mesh>) {
    """Вырезать из кладки (локально: x вдоль, y вверх) стадион окна: прямоугольник
    косяков + верхняя полуокружность. Контур = наружный силуэт arch_frame
    (полуширина r+bar) плюс зазор gap. Кирпичи снаружи целые, на контуре
    подрезаны; внутри проёма удалены."""
    r = win_w * 0.5
    R = r + bar + gap
    straight = win_h - r
    cy = y_bot + straight
    y_sill = y_bot - gap
    y_top = cy + R + 0.10
    left = clip(g, origin = vec3(cx - R, 0, 0), normal = vec3(-1, 0, 0), cap_group = "brick")
    right = clip(g, origin = vec3(cx + R, 0, 0), normal = vec3(1, 0, 0), cap_group = "brick")
    m0 = clip(g, origin = vec3(cx - R, 0, 0), normal = vec3(1, 0, 0))
    mid = clip(m0, origin = vec3(cx + R, 0, 0), normal = vec3(-1, 0, 0))
    bot = clip(mid, origin = vec3(0, y_sill, 0), normal = vec3(0, -1, 0), cap_group = "brick")
    top = clip(mid, origin = vec3(0, y_top, 0), normal = vec3(0, 1, 0), cap_group = "brick")
    ah0 = clip(mid, origin = vec3(0, cy, 0), normal = vec3(0, 1, 0))
    ah = clip(ah0, origin = vec3(0, y_top, 0), normal = vec3(0, -1, 0))
    w0 = clip_wedge_out(ah, cx = cx, cy = cy, R = R, deg0 = 0.0, deg1 = 15.0)
    wedges = repeat (w0, iterations = 11) |acc| {
        i = f32(@iteration) + 1.0
        d0 = i * 15.0
        acc = merge(acc, clip_wedge_out(ah, cx = cx, cy = cy, R = R, deg0 = d0, deg1 = d0 + 15.0))
    }
    out = compute_normals(merge(left, right, bot, top, wedges), mode = flat)
}

def clip_circle_hole(g: geo<mesh>, cx: f32, cy: f32, R: f32) -> (out: geo<mesh>) {
    """Вырезать диск (cx, cy, R) из кладки: 12 секторов по 30° снаружи окружности."""
    w0 = clip_wedge_out(g, cx = cx, cy = cy, R = R, deg0 = 0.0, deg1 = 30.0)
    wedges = repeat (w0, iterations = 11) |acc| {
        i = f32(@iteration) + 1.0
        d0 = i * 30.0
        acc = merge(acc, clip_wedge_out(g, cx = cx, cy = cy, R = R, deg0 = d0, deg1 = d0 + 30.0))
    }
    out = compute_normals(wedges, mode = flat)
}

def brick_box_veneer(w: f32, d: f32, h: f32, y0: f32, wing_x: f32, wing_z: f32, door_x: f32, has_door: int, rng: rng) -> (out: geo<mesh>) {
    """Облицовка четырёх стен дома мелким кирпичом между квойнами (inset 0.74
    как у cottage, bricks=1.5). Сплошная кладка, проёмы — clip_arch_hole по
    силуэту stone_arch_window / arch_frame (зазор 3 см). has_door=1 — на
    фасаде справа дверь вместо окна."""
    inset = 0.74
    span_f = w - 2.0 * inset
    span_s = d - 2.0 * inset
    win_w = 0.72
    win_h = 2.15
    win_bar = 0.11
    win_y = 0.35
    gap = 0.03
    door_w = 1.05
    door_h = 2.35
    door_bar = 0.14
    rf0 = brick_rows(len = span_f, h = h)
    rs0 = brick_rows(len = span_s, h = h)
    raw_f = brick_from_rows(rf0, rng = split_rng(rng, key = "f"))
    p_f0 = clip_arch_hole(raw_f, cx = 0.0 - wing_x, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    cx2 = has_door == 1 ? door_x : wing_x
    y2 = has_door == 1 ? 0.0 : win_y
    w2 = has_door == 1 ? door_w : win_w
    h2 = has_door == 1 ? door_h : win_h
    bar2 = has_door == 1 ? door_bar : win_bar
    p_f = clip_arch_hole(p_f0, cx = cx2, y_bot = y2, win_w = w2, win_h = h2, bar = bar2, gap = gap)
    raw_b = brick_from_rows(rf0, rng = split_rng(rng, key = "b"))
    p_b0 = clip_arch_hole(raw_b, cx = 0.0 - wing_x, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    p_b = clip_arch_hole(p_b0, cx = wing_x, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    raw_r = brick_from_rows(rs0, rng = split_rng(rng, key = "r"))
    p_r0 = clip_arch_hole(raw_r, cx = wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    p_r = clip_arch_hole(p_r0, cx = 0.0 - wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    raw_l = brick_from_rows(rs0, rng = split_rng(rng, key = "l"))
    p_l0 = clip_arch_hole(raw_l, cx = wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    p_l = clip_arch_hole(p_l0, cx = 0.0 - wing_z, y_bot = win_y, win_w = win_w, win_h = win_h, bar = win_bar, gap = gap)
    wall_f = transform(p_f, translate = vec3(0, y0, d * 0.5))
    wall_b = transform(transform(p_b, rotate = vec3(0, 180, 0)), translate = vec3(0, y0, 0.0 - d * 0.5))
    wall_r = transform(transform(p_r, rotate = vec3(0, 90, 0)), translate = vec3(w * 0.5, y0, 0))
    wall_l = transform(transform(p_l, rotate = vec3(0, 270, 0)), translate = vec3(0.0 - w * 0.5, y0, 0))
    out = merge(wall_f, wall_b, wall_r, wall_l)
}

def hexa_brick_face(h: f32, r_in: f32, r_out: f32, y_bot: f32, win_w: f32, win_h: f32, rng: rng) -> (out: geo<mesh>) {
    """Кладка одной грани шестигранника (лицо +Z, низ y=0): пролёт r_out − 0.16
    (отступ от колоннетт). Сплошной ряд, проём — clip_arch_hole по окну
    win_w×win_h (bar=0.11, зазор 3 см)."""
    span = r_out - 0.16
    rows = brick_rows(len = span, h = h)
    raw = brick_from_rows(rows, rng = rng)
    punched = clip_arch_hole(raw, cx = 0.0, y_bot = y_bot, win_w = win_w, win_h = win_h, bar = 0.11, gap = 0.03)
    out = transform(punched, translate = vec3(0, 0, r_in))
}

def hexa_brick_clock_face(h: f32, r_in: f32, r_out: f32, cy: f32, circ_r: f32, rng: rng) -> (out: geo<mesh>) {
    """Кладка грани с круглым вырезом под циферблат (радиус circ_r + 3 см)."""
    span = r_out - 0.16
    rows = brick_rows(len = span, h = h)
    raw = brick_from_rows(rows, rng = rng)
    punched = clip_circle_hole(raw, cx = 0.0, cy = cy, R = circ_r + 0.03)
    out = transform(punched, translate = vec3(0, 0, r_in))
}

def belt(w: f32, d: f32, h: f32, over_lo: f32 = 0.22, over_hi: f32 = 0.30) -> (out: geo<mesh>) {
    """Светлый поясной карниз по периметру w×d: две ступенчатые плиты (нижняя уже
    и толще, верхняя шире и тоньше), центр в 0, низ на y = 0. over_lo / over_hi —
    вынос каждой ступени от стены на сторону (квойны quoin_stack выпускаются на
    0.20: межэтажный пояс должен чуть перекрывать их, венчающий — ещё на шаг).
    Группа stone."""
    lo = parts.piece(size = vec3(w + over_lo * 2.0, h * 0.58, d + over_lo * 2.0), pos = vec3(0, h * 0.29, 0), grp = "stone")
    hi = parts.piece(size = vec3(w + over_hi * 2.0, h * 0.42, d + over_hi * 2.0), pos = vec3(0, h * 0.79, 0), grp = "stone")
    out = merge(lo, hi)
}

def dentils(w: f32, d: f32, y: f32) -> (out: geo<mesh>) {
    """Ряд мелких сухариков (дентикулов) под венчающим карнизом по периметру w×d."""
    s = 0.18
    nx = int(w / s)
    nz = int(d / s)
    pts_fx = transform(mesh_line(count = nx, length = f32(nx - 1) * s, dir = (1, 0, 0)), translate = vec3(0.0 - f32(nx - 1) * s * 0.5, y, d * 0.5 + 0.05))
    pts_bx = transform(mesh_line(count = nx, length = f32(nx - 1) * s, dir = (1, 0, 0)), translate = vec3(0.0 - f32(nx - 1) * s * 0.5, y, 0.0 - d * 0.5 - 0.05))
    pts_lz = transform(mesh_line(count = nz, length = f32(nz - 1) * s, dir = (0, 0, 1)), translate = vec3(0.0 - w * 0.5 - 0.05, y, 0.0 - f32(nz - 1) * s * 0.5))
    pts_rz = transform(mesh_line(count = nz, length = f32(nz - 1) * s, dir = (0, 0, 1)), translate = vec3(w * 0.5 + 0.05, y, 0.0 - f32(nz - 1) * s * 0.5))
    all_pts = merge(pts_fx, pts_bx, pts_lz, pts_rz)
    dent = mark(compute_normals(box(size = vec3(0.09, 0.08, 0.09)), mode = flat), "stone", where = true, domain = faces)
    out = realize(instance_on_points(all_pts, source = dent))
}

def corbel(w: f32, d: f32, h: f32, steps: int = 5) -> (out: geo<mesh>) {
    """Ступенчатый каменный консольный сход под эркером: n ступеней сверху вниз,
    каждая следующая уже и ближе к стене. Верх консоли на y = h, низ на y = 0."""
    st_h = h / f32(steps)
    st0_frac = 1.0
    st0_w = w * st0_frac
    st0_d = d * st0_frac
    st0_y = h - st_h * 0.5
    st0_z = d * 0.5 - (d - st0_d) * 0.5
    b0 = parts.piece(size = vec3(st0_w, st_h * 0.95, st0_d), pos = vec3(0, st0_y, st0_z), grp = "stone")
    out = repeat (b0, iterations = steps - 1) |acc| {
        k = f32(@iteration) + 1.0
        frac = 1.0 - k * (0.62 / f32(steps))
        sw = w * frac
        sd = d * frac
        sy = h - (k + 0.5) * st_h
        sz = d * 0.5 - (d - sd) * 0.5
        acc = merge(acc, parts.piece(size = vec3(sw, st_h * 0.95, sd), pos = vec3(0, sy, sz), grp = "stone"))
    }
}

def octa_frustum(y0: f32, y1: f32, r0: f32, r1: f32, grp: string) -> (out: geo<mesh>) {
    """Правильная восьмигранная усечённая пирамида (frustum) от y0 до y1."""
    h = y1 - y0
    path0 = mesh_line(count = 2, length = h, dir = (0, 1, 0))
    path = set(path0, "profile_scale", @index == 0 ? vec2(r0, r0) : vec2(r1, r1))
    prof = transform(circle(sides = 8, radius = 1.0), rotate = vec3(0, 0, 22.5))
    sw = sweep(path, profile = prof)
    sw_y = transform(sw, translate = vec3(0, y0, 0))
    out = mark(compute_normals(sw_y, mode = flat), grp, where = true, domain = faces)
}

def hexa_frustum(y0: f32, y1: f32, r0: f32, r1: f32, grp: string) -> (out: geo<mesh>) {
    """Правильная шестигранная усечённая призма/пирамида от y0 до y1 (грань на +Z)."""
    h = y1 - y0
    path0 = mesh_line(count = 2, length = h, dir = (0, 1, 0))
    path = set(path0, "profile_scale", @index == 0 ? vec2(r0, r0) : vec2(r1, r1))
    prof = transform(circle(sides = 6, radius = 1.0), rotate = vec3(0, 0, 30.0))
    sw = sweep(path, profile = prof)
    sw_y = transform(sw, translate = vec3(0, y0, 0))
    out = mark(compute_normals(sw_y, mode = flat), grp, where = true, domain = faces)
}

def hexa_ring(y: f32, r: f32) -> (out: geo<mesh>) {
    """Тонкое шестигранное профилированное кольцо-поясок вокруг шпиля."""
    prof = transform(circle(sides = 6, radius = r), rotate = vec3(0, 0, 30.0))
    path = mesh_line(count = 2, length = 0.06, dir = (0, 1, 0))
    sw = sweep(path, profile = prof)
    sw_y = transform(sw, translate = vec3(0, y, 0))
    out = mark(compute_normals(sw_y, mode = flat), "stone", where = true, domain = faces)
}

def hexa_corbel(y_top: f32, h: f32, r_top: f32, steps: int = 3) -> (out: geo<mesh>) {
    """Ступенчатый каменный консольный сход под шестигранным эркером:
    наклонные шестигранные усечённые пирамиды (frustums) с каменными полочками-выступами."""
    st_h = h / 3.0
    # Верхняя ступень (наиболее широкая, наклон граней внутрь)
    s0 = hexa_frustum(y0 = y_top - st_h, y1 = y_top, r0 = r_top * 0.82, r1 = r_top * 1.04, grp = "stone")
    # Средняя ступень
    s1 = hexa_frustum(y0 = y_top - st_h * 2.0, y1 = y_top - st_h, r0 = r_top * 0.54, r1 = r_top * 0.85, grp = "stone")
    # Нижняя ступень
    s2 = hexa_frustum(y0 = y_top - h, y1 = y_top - st_h * 2.0, r0 = r_top * 0.28, r1 = r_top * 0.57, grp = "stone")
    # Каплевидный наконечник-финиал
    y_bot = y_top - h
    drop_cone = hexa_frustum(y0 = y_bot - 0.24, y1 = y_bot, r0 = 0.05, r1 = r_top * 0.30, grp = "stone")
    drop_ball = mark(compute_normals(transform(ico_sphere(subdiv = 1, radius = 0.07), translate = vec3(0, y_bot - 0.28, 0)), mode = auto), "stone", where = true, domain = faces)
    out = merge(s0, s1, s2, drop_cone, drop_ball)
}

def hexa_belt(y: f32, h: f32, r: f32, over_lo: f32 = 0.22, over_hi: f32 = 0.30) -> (out: geo<mesh>) {
    """Шестигранный двухступенчатый карниз: тот же разрез, что у belt (низ 0.58·h /
    вынос over_lo, верх 0.42·h / over_hi). r — описанный радиус грани корпуса
    (hexa_frustum); over_* — вынос от грани на сторону, в описанный радиус через 2/√3.
    Фаска как у belt/cbox: ширина k=0.12 от высоты полки, грани в группе edge."""
    k = 1.1547
    lo_h = h * 0.58
    hi_h = h * 0.42
    lo = hexa_frustum(y0 = y, y1 = y + lo_h, r0 = r + over_lo * k, r1 = r + over_lo * k, grp = "stone")
    hi = hexa_frustum(y0 = y + lo_h, y1 = y + h, r0 = r + over_hi * k, r1 = r + over_hi * k, grp = "stone")
    lo_b = compute_normals(mark(bevel(lo, width = 0.12 * lo_h, bevel_group = "edge"), "stone", where = true, domain = faces), mode = flat)
    hi_b = compute_normals(mark(bevel(hi, width = 0.12 * hi_h, bevel_group = "edge"), "stone", where = true, domain = faces), mode = flat)
    out = merge(lo_b, hi_b)
}

def hexa_crown(y: f32, h: f32, r: f32) -> (out: geo<mesh>) {
    """Шестигранный венчающий профилированный карниз из 3 ступеней."""
    s1 = hexa_frustum(y0 = y, y1 = y + h * 0.35, r0 = r + 0.05, r1 = r + 0.07, grp = "stone")
    s2 = hexa_frustum(y0 = y + h * 0.35, y1 = y + h * 0.70, r0 = r + 0.12, r1 = r + 0.14, grp = "stone")
    s3 = hexa_frustum(y0 = y + h * 0.70, y1 = y + h, r0 = r + 0.20, r1 = r + 0.20, grp = "stone")
    out = merge(s1, s2, s3)
}

def hexa_dentils(y: f32, r_in: f32) -> (out: geo<mesh>) {
    """Ряд сухариков (дентикулов) под венчающим карнизом шестигранной башни."""
    d0 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.0 - 0.36, y, r_in + 0.03), grp = "stone")
    d1 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.0 - 0.12, y, r_in + 0.03), grp = "stone")
    d2 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.12, y, r_in + 0.03), grp = "stone")
    d3 = parts.piece(size = vec3(0.08, 0.07, 0.08), pos = vec3(0.36, y, r_in + 0.03), grp = "stone")
    face_d = merge(d0, d1, d2, d3)
    out = merge(face_d, transform(face_d, rotate = vec3(0, 60, 0)), transform(face_d, rotate = vec3(0, 120, 0)), transform(face_d, rotate = vec3(0, 180, 0)), transform(face_d, rotate = vec3(0, 240, 0)), transform(face_d, rotate = vec3(0, 300, 0)))
}

def octa_ring(y: f32, r: f32) -> (out: geo<mesh>) {
    """Тонкое восьмигранное профилированное кольцо-поясок вокруг шпиля."""
    prof = circle(sides = 8, radius = r)
    path = mesh_line(count = 2, length = 0.06, dir = (0, 1, 0))
    sw = sweep(path, profile = prof)
    sw_y = transform(sw, translate = vec3(0, y, 0))
    out = mark(compute_normals(sw_y, mode = flat), "stone", where = true, domain = faces)
}

def cone_r(y: f32, r0: f32, h: f32) -> (out: f32) {
    """Радиус описанной окружности конуса шпиля на высоте y (линейный спад от r0 до 0.05)."""
    t = y / h
    out = r0 * (1.0 - t) + 0.05 * t
}

def spire_lucarne(w: f32, h: f32, d: f32) -> (out: geo<mesh>) {
    """Маленькая слуховая люкарна шпиля: фасад смотрит на +Z, глубина d уходит внутрь шпиля в -Z."""
    box_w = parts.piece(size = vec3(w, h * 0.7, d), pos = vec3(0, h * 0.35, 0.0 - d * 0.5), grp = "stone")
    win = parts.piece(size = vec3(w * 0.55, h * 0.5, 0.04), pos = vec3(0, h * 0.4, 0.02), grp = "glass")
    arch = parts.piece(size = vec3(w * 0.65, h * 0.22, 0.06), pos = vec3(0, h * 0.72, 0.03), grp = "stone")
    roof_w = parts.piece(size = vec3(w + 0.08, 0.08, d + 0.06), pos = vec3(0, h * 0.88, 0.0 - d * 0.5), grp = "roof")
    out = merge(box_w, win, arch, roof_w)
}

def rail_run(len: f32, h: f32) -> (out: geo<mesh>) {
    """Кованое ограждение террасы/палубы заданной длины."""
    top_r = parts.piece(size = vec3(len, 0.04, 0.04), pos = vec3(0, h, 0), grp = "iron")
    bot_r = parts.piece(size = vec3(len, 0.04, 0.04), pos = vec3(0, 0.08, 0), grp = "iron")
    n_p = int(len / 0.32)
    pts = transform(mesh_line(count = n_p, length = f32(n_p - 1) * 0.32, dir = (1, 0, 0)), translate = vec3(0.0 - f32(n_p - 1) * 0.32 * 0.5, 0, 0))
    picket = parts.piece(size = vec3(0.025, h - 0.08, 0.025), pos = vec3(0, (h + 0.08) * 0.5, 0), grp = "iron")
    pickets = realize(instance_on_points(pts, source = picket))
    out = merge(top_r, bot_r, pickets)
}
