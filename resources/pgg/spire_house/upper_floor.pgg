# Второй этаж здания: кирпичные стены второго этажа, угловые квойны,
# венчающий развитый карниз (crown) и ряд сухариков-дентикулов.
import lib.parts
import lib.blockwork
import spire_house.common as common

def upper_floor(width: f32, depth: f32, b1_top: f32, floor2_h: f32, crown_h: f32) -> (out: geo<mesh>) {
    """Второй этаж здания:
    - Кирпичные стены 2-го этажа (от межэтажного пояска до карниза);
    - Угловые рустованные квойны 2-го этажа;
    - Венчающий развитый карниз (crown);
    - Поясок сухариков (дентикулов) под карнизом."""
    f2_top = b1_top + floor2_h
    wall_2 = parts.piece(size = vec3(width, floor2_h, depth), pos = vec3(0, b1_top + floor2_h * 0.5, 0), grp = "brick")
    n_rows_2 = 7
    course_h_2 = floor2_h / f32(n_rows_2)
    quoins_2 = transform(blockwork.quoin_stack(w = width, d = depth, n_rows = n_rows_2, course_h = course_h_2, bricks = 1.5), translate = vec3(0, b1_top, 0))
    crown = transform(common.belt(w = width, d = depth, h = crown_h, over_lo = 0.26, over_hi = 0.36), translate = vec3(0, f2_top, 0))
    crown_dt = common.dentils(w = width + 0.1, d = depth + 0.1, y = f2_top - 0.12)
    out = merge(wall_2, quoins_2, crown, crown_dt)
}
