{
  "mcpServers": {
    "blender": {
      "command": "/bin/sh",
      "args": [
        "tools/run_blender_mcp_server.sh"
      ],
      "cwd": ".",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "neverwhere-debug": {
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run_mcp_server.ps1"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NEVERWHERE_REPO_ROOT": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "CRASH_ANALYSIS_DEBUGGER_PATH": "C:/Program Files (x86)/Windows Kits/10/Debuggers/x64/cdb.exe"
      }
    },
    "neverwhere-debug-macos": {
      "command": "/bin/sh",
      "args": [
        "tools/run_mcp_server.sh"
      ],
      "cwd": ".",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "neverwhere-editor": {
      "command": "/bin/sh",
      "args": [
        "tools/run_editor_mcp_server.sh"
      ],
      "cwd": ".",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "neverwhere-editor-win": {
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run_editor_mcp_server.ps1"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NEVERWHERE_REPO_ROOT": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  }
}
