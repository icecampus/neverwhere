# Растительность: пучки травы и клумба с листвой/цветами/плетями. Всё —
# инстансы простых форм на точках; группы grass, leaf, flower, wood (ящик).

import lib.parts

def grass_clump(at: vec3, rng: rng) -> (out: geo<mesh>) {
    """Пучок травы: 7 тонких вытянутых пирамидок с разбросом позиции, наклона и масштаба."""
    blade0 = compute_normals(box(size = vec3(0.05, 0.3, 0.05)), mode = flat)
    blade = transform(blade0, translate = vec3(0, 0.15, 0))
    pts0 = mesh_line(count = 7, length = 0.36, dir = (1, 0, 0))
    pts1 = transform(pts0, translate = vec3(-0.18, 0, 0))
    pts2 = set_position(pts1, offset = random_vec(lo = vec3(-0.06, 0, -0.1), hi = vec3(0.06, 0, 0.1), rng = split_rng(rng, key = "pos")))
    pts3 = set(pts2, "scale", random(lo = 0.6, hi = 1.3, rng = split_rng(rng, key = "scale")))
    pts4 = set(pts3, "orient", orient_from_euler(random_vec(lo = vec3(-28, 0, -28), hi = vec3(28, 360, 28), rng = split_rng(rng, key = "tilt"))))
    g = mark(realize(instance_on_points(pts4, source = blade)), "grass", where = true, domain = faces)
    out = transform(g, translate = at)
}

def flower_box(w: f32, d: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Деревянная клумба под окном с зеленью, в локальной системе: стена — z = 0,
    ящик w×h×d выступает в +Z, центр ящика по y — 0. Три вертикальные накладки и
    поясок спереди, два косых кронштейна снизу; над ящиком облако листвы (икосферы),
    цветы четырёх оттенков (@tint по random_int), четыре свисающие плети-цепочки
    у переднего края. Группы: wood, leaf, flower."""
    fb_front = parts.piece(size = vec3(w, h, 0.06), pos = vec3(0, 0, d - 0.03), grp = "wood")
    fb_left = parts.piece(size = vec3(0.06, h, d), pos = vec3(0.0 - w * 0.5 + 0.03, 0, d * 0.5), grp = "wood")
    fb_right = parts.piece(size = vec3(0.06, h, d), pos = vec3(w * 0.5 - 0.03, 0, d * 0.5), grp = "wood")
    fb_bottom = parts.piece(size = vec3(w, 0.06, d), pos = vec3(0, 0.0 - h * 0.5 + 0.03, d * 0.5), grp = "wood")
    fb_band = parts.piece(size = vec3(w + 0.04, 0.07, 0.04), pos = vec3(0, 0.02, d + 0.01), grp = "wood")
    fb_bat1 = parts.piece(size = vec3(0.08, h + 0.04, 0.08), pos = vec3(0.0 - w * 0.5 + 0.02, 0, d + 0.01), grp = "wood")
    fb_bat2 = parts.piece(size = vec3(0.08, h + 0.04, 0.08), pos = vec3(w * 0.5 - 0.02, 0, d + 0.01), grp = "wood")
    fb_bat3 = parts.piece(size = vec3(0.08, h + 0.04, 0.08), pos = vec3(0, 0, d + 0.01), grp = "wood")
    fb_brk1 = transform(parts.piece(size = vec3(0.08, 0.5, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(45, 0, 0))
    fb_brk_l = transform(fb_brk1, translate = vec3(0.0 - w * 0.5 + 0.1, 0.0 - h * 0.5 - 0.16, 0.18))
    fb_brk_r = transform(fb_brk1, translate = vec3(w * 0.5 - 0.1, 0.0 - h * 0.5 - 0.16, 0.18))
    box = merge(fb_front, fb_left, fb_right, fb_bottom, fb_band, fb_bat1, fb_bat2, fb_bat3, fb_brk_l, fb_brk_r)
    # Зелень: облако листвы над ящиком, цветы — мелкие сферы поверх, плети — цепочки
    # маленьких сфер, свисающие с переднего края.
    leaf_src = ico_sphere(subdiv = 1, radius = 0.13)
    leaf_pts0 = point_cloud(count = 70, bounds = vec3(w - 0.2, 0.22, d - 0.06), rng = split_rng(rng, key = "leaf_pos"))
    leaf_pts1 = transform(leaf_pts0, translate = vec3(0, h * 0.5 + 0.1, d * 0.5 + 0.03))
    leaf_pts = set(leaf_pts1, "scale", random(lo = 0.7, hi = 1.4, rng = split_rng(rng, key = "leaf_scale")))
    leaves = mark(realize(instance_on_points(leaf_pts, source = leaf_src)), "leaf", where = true, domain = faces)
    flower_src = ico_sphere(subdiv = 1, radius = 0.07)
    flower_pts0 = point_cloud(count = 30, bounds = vec3(w - 0.3, 0.14, d - 0.1), rng = split_rng(rng, key = "flower_pos"))
    flower_pts1 = transform(flower_pts0, translate = vec3(0, h * 0.5 + 0.3, d * 0.5 + 0.06))
    flower_pts2 = set(flower_pts1, "scale", random(lo = 0.7, hi = 1.3, rng = split_rng(rng, key = "flower_scale")))
    flower_pick = random_int(n = 4, rng = split_rng(rng, key = "flower_color"))
    flower_col = flower_pick == 0 ? vec3(0.45, 0.12, 0.7) : (flower_pick == 1 ? vec3(0.95, 0.75, 0.1) : (flower_pick == 2 ? vec3(0.9, 0.25, 0.45) : vec3(0.2, 0.35, 0.95)))
    flower_pts = set(flower_pts2, "tint", flower_col)
    flowers = mark(realize(instance_on_points(flower_pts, source = flower_src)), "flower", where = true, domain = faces)
    vine_src = ico_sphere(subdiv = 1, radius = 0.075)
    vine_a = transform(mesh_line(count = 9, length = 0.85, dir = (0, -1, 0)), translate = vec3(0.0 - w * 0.365, 0.16, d + 0.06))
    vine_b = transform(mesh_line(count = 7, length = 0.6, dir = (0, -1, 0)), translate = vec3(0.0 - w * 0.106, 0.16, d + 0.06))
    vine_c = transform(mesh_line(count = 10, length = 1.0, dir = (0, -1, 0)), translate = vec3(w * 0.176, 0.16, d + 0.06))
    vine_d = transform(mesh_line(count = 6, length = 0.5, dir = (0, -1, 0)), translate = vec3(w * 0.4, 0.16, d + 0.06))
    vine_pts0 = merge(vine_a, vine_b, vine_c, vine_d)
    vine_pts1 = set_position(vine_pts0, offset = random_vec(lo = vec3(-0.05, -0.02, -0.03), hi = vec3(0.05, 0.02, 0.03), rng = split_rng(rng, key = "vine_pos")))
    vine_pts = set(vine_pts1, "scale", random(lo = 0.7, hi = 1.2, rng = split_rng(rng, key = "vine_scale")))
    vines = mark(realize(instance_on_points(vine_pts, source = vine_src)), "leaf", where = true, domain = faces)
    out = merge(box, leaves, flowers, vines)
}
