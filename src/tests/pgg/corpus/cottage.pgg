param width: f32 = 5.6
param depth: f32 = 4.6
param stone_h: f32 = 2.5
param upper_h: f32 = 2.4
param jetty: f32 = 0.18
param overhang: f32 = 0.45
param seed: int = 7

# Стилизованный фахверковый коттедж по референсу (grok-image-905a2b41): узкий
# высокий дом — каменный первый этаж из отдельных блоков (с настоящими проёмами
# под дверь и окна), фахверковый второй этаж со свесом (jetty) и торцами балок,
# арочная дверь в каменном портале с двумя фонарями, окно со ставнями справа от
# двери, одно большое окно во фронтоне над деревянной клумбой с цветами и
# свисающими плетями, крутая двускатная крыша 45° из плоских сланцевых плиток,
# каменная труба на правом скате с дымом, пучки травы у цоколя.
# 
# Верх — ось Y, фасад с дверью и фронтоном смотрит в +Z, конёк вдоль Z (скаты
# крыши выходят на ±X). Крыша собирается в локальной системе (конёк вдоль X) и
# поворачивается на 90° вокруг Y при установке.
# 
# Материалы — группы faces (в PggViewer: highlight = faces:<имя>):
# stone (кладка, цоколь, портал, ступень, труба), wall (штукатурка + фронтоны),
# wood (балки, рамы, ставни, дверь, клумба, ветровые доски), glass (стёкла),
# lamp (светящиеся корпуса фонарей), roof (настил), tile (черепица и конёк),
# leaf (зелень), flower (цветы), grass (трава), smoke (дым). Цвет — `@Cd` на
# faces по группам в блоке «окраска» внизу (превью: чекбокс «colors (@Cd)»).
def piece(size: vec3, pos: vec3, grp: string) -> (out: geo<mesh>) {
    """Прямоугольный брус/блок: box размером size с центром в pos, все грани в группе grp.
    Фасеточные corner-N: сварной box несёт гладкие point-@N (диагонали углов, §8.1),
    и в превью большая плоская грань шейдится «подушкой»."""
    b = compute_normals(box(size = size), mode = flat)
    placed = transform(b, translate = pos)
    out = mark(placed, grp, where = true, domain = faces)
}

def place(g: geo<mesh>, yaw_deg: f32, at: vec3) -> (out: geo<mesh>) {
    """Поворот меша вокруг Y на yaw_deg (0 = смотрит в +Z) и перенос в at."""
    r = transform(g, rotate = vec3(0, yaw_deg, 0))
    out = transform(r, translate = at)
}

def sdf_box_at(size: vec3, pos: vec3) -> (out: sdf) {
    """SDF-бокс с центром в pos (через @P одиночной точки)."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt = transform(pt0, translate = pos)
    out = sdf_instance_on_points(pt, source = sdf_box(size = size))
}

def sdf_sphere_at(r: f32, pos: vec3) -> (out: sdf) {
    """SDF-сфера с центром в pos."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt = transform(pt0, translate = pos)
    out = sdf_instance_on_points(pt, source = sdf_sphere(r = r))
}

def slab_at(ridge: vec3, tilt_deg: f32, span: f32) -> (out: sdf) {
    """Полупространство-скат под 45°: бокс span×span×span, повёрнутый на tilt_deg
    вокруг X, верхняя грань проходит через точку ridge (толщина бокса — вниз)."""
    pt0 = mesh_line(count = 1, length = 0.0)
    pt1 = set(pt0, "orient", orient_from_euler(vec3(tilt_deg, 0, 0)))
    pt = transform(pt1, translate = ridge)
    slab0 = sdf_box(size = vec3(span, span, span))
    out = sdf_instance_on_points(pt, source = slab0)
}

def gable_prism(ridge_y: f32, drop: f32, w: f32, d: f32, floor_y: f32) -> (out: sdf) {
    """Треугольная призма крыши 45°: конёк на высоте ridge_y − drop, длина конька w
    (вдоль X), скаты до floor_y. drop — сдвиг плоскостей скатов вниз (толщина кровли)."""
    span = (w + d) * 3.0
    half = span * 0.5 * 0.70710678
    right = slab_at(ridge = vec3(0, ridge_y - drop - half, half), tilt_deg = 45.0, span = span)
    left = slab_at(ridge = vec3(0, ridge_y - drop - half, 0 - half), tilt_deg = 0.0 - 45.0, span = span)
    top_y = ridge_y - drop
    # Ограничивающий бокс — ПЕРВЫЙ операнд intersect: conservative bbox
    # пересечения = bbox(a), и грид mesh_from_sdf берётся по нему, а не по
    # гигантскому скату (иначе 600³ вокселей и минуты счёта).
    bounds = sdf_box_at(size = vec3(w, top_y - floor_y, (top_y - floor_y) * 2.0 + 0.1), pos = vec3(0, (top_y + floor_y) * 0.5, 0))
    out = sdf_intersect(bounds, sdf_intersect(right, left))
}

def arch_sdf(w: f32, straight: f32, r: f32, t: f32) -> (out: sdf) {
    """Арочная плита: бокс w×straight×t (низ на y=0, центр по x/z в 0) плюс диск
    радиуса r сверху — сфера, зажатая тонким боксом (толщина плиты t)."""
    body = sdf_box_at(size = vec3(w, straight, t), pos = vec3(0, straight * 0.5, 0))
    slab = sdf_box_at(size = vec3(r * 2.0, r * 2.0, t), pos = vec3(0, straight, 0))
    ball = sdf_sphere_at(r = r, pos = vec3(0, straight, 0))
    disc = sdf_intersect(slab, ball)
    out = sdf_union(body, disc)
}

def window(w: f32, h: f32) -> (out: geo<mesh>) {
    """Окно в начале координат, смотрит в +Z: рама w×h с крестовиной (2×2 стекла),
    стекло чуть утоплено, подоконник. Задняя плоскость рамы — z = −0.06."""
    frame = piece(size = vec3(w, h, 0.12), pos = (0, 0, 0), grp = "wood")
    glass = piece(size = vec3(w - 0.2, h - 0.2, 0.13), pos = (0, 0, 0), grp = "glass")
    bar_v = piece(size = vec3(0.07, h - 0.2, 0.16), pos = (0, 0, 0), grp = "wood")
    bar_h = piece(size = vec3(w - 0.2, 0.07, 0.16), pos = (0, 0, 0), grp = "wood")
    sill = piece(size = vec3(w + 0.24, 0.09, 0.26), pos = vec3(0, 0.0 - h * 0.5 - 0.02, 0.05), grp = "wood")
    out = merge(frame, glass, bar_v, bar_h, sill)
}

def plank_panel(w: f32, h: f32, t: f32, n: int, rng: rng) -> (out: geo<mesh>) {
    """Щит из n вертикальных досок общей ширины w, высоты h, толщины t; центр в 0,
    лицо в +Z. Доска = box шириной (шаг − 0.008): шов-зазор, плюс на доску свой
    выступ по z (±0.006) и оттенок @tint (полутоновая полоса читается и при плоском
    свете, когда шов не виден). Доски — инстансы на mesh_line, один realize."""
    pitch = w / f32(n)
    plank = compute_normals(box(size = vec3(pitch - 0.008, h, t)), mode = flat)
    pts0 = mesh_line(count = n, length = w - pitch, dir = (1, 0, 0))
    pts1 = transform(pts0, translate = vec3(0.0 - (w - pitch) * 0.5, 0, 0))
    pts2 = set_position(pts1, offset = random_vec(lo = vec3(0, 0, -0.006), hi = vec3(0, 0, 0.006), rng = split_rng(rng, key = "z")))
    shade = random(lo = 0.78, hi = 1.22, rng = split_rng(rng, key = "tint"))
    pts3 = set(pts2, "tint", vec3(shade * 1.03, shade, shade * 0.95))
    out = mark(realize(instance_on_points(pts3, source = plank)), "wood", where = true, domain = faces)
}

def shutter(sw: f32, h: f32, rng: rng) -> (out: geo<mesh>) {
    """Ставня: щит из трёх вертикальных досок плюс две поперечные планки; центр в 0, лицо в +Z."""
    panel = plank_panel(w = sw, h = h, t = 0.05, n = 3, rng = rng)
    b1 = piece(size = vec3(sw - 0.03, 0.06, 0.03), pos = vec3(0, h * 0.3, 0.04), grp = "wood")
    b2 = piece(size = vec3(sw - 0.03, 0.06, 0.03), pos = vec3(0, 0.0 - h * 0.3, 0.04), grp = "wood")
    out = merge(panel, b1, b2)
}

def window_sh(w: f32, h: f32, off: f32, rng: rng) -> (out: geo<mesh>) {
    """Окно с двумя распахнутыми ставнями плашмя к стене по бокам рамы; off — z центра
    ставен относительно окна (у каменного этажа больше: кладка выступает до 0.2)."""
    win = window(w = w, h = h)
    sw = w * 0.48
    sh_l = transform(shutter(sw = sw, h = h * 0.96, rng = split_rng(rng, key = "l")), translate = vec3(0.0 - w * 0.5 - sw * 0.5 - 0.03, 0, off))
    sh_r = transform(shutter(sw = sw, h = h * 0.96, rng = split_rng(rng, key = "r")), translate = vec3(w * 0.5 + sw * 0.5 + 0.03, 0, off))
    out = merge(win, sh_l, sh_r)
}

def lantern(at: vec3) -> (out: geo<mesh>) {
    """Настенный фонарь: кронштейн из стены (−Z → +Z), стеклянный корпус на крюке, крышка."""
    arm = piece(size = vec3(0.06, 0.06, 0.34), pos = vec3(0, 0.28, 0.17), grp = "wood")
    hook = piece(size = vec3(0.04, 0.12, 0.04), pos = vec3(0, 0.2, 0.32), grp = "wood")
    body = piece(size = vec3(0.2, 0.26, 0.2), pos = vec3(0, 0.0, 0.32), grp = "lamp")
    cap = piece(size = vec3(0.26, 0.05, 0.26), pos = vec3(0, 0.155, 0.32), grp = "wood")
    base = piece(size = vec3(0.22, 0.04, 0.22), pos = vec3(0, 0.0 - 0.15, 0.32), grp = "wood")
    l0 = merge(arm, hook, body, cap, base)
    out = transform(l0, translate = at)
}

def stone_wall(rows: geo<points>, len: f32, blk: vec3, rng: rng) -> (out: geo<mesh>) {
    """Кладка одной стены в локальной системе (x вдоль стены, центр в 0): ряды якорей
    → блок с центром за краем не кладётся → @scale/@variant (три длины blk × 1 / 1.1 / 1.2 — не длиннее шага ряда, чтобы соседи не сливались в плиту)
    → почти серый @tint → джиттер → realize → подрезка торцов плоскостями x = ±len/2
    (`clip`, крышки срезов в группе `cut`). Ставится на место внешним transform."""
    a0 = compute_normals(box(size = blk), mode = flat)
    a1 = compute_normals(box(size = blk * vec3(1.1, 1, 1)), mode = flat)
    a2 = compute_normals(box(size = blk * vec3(1.2, 1, 1)), mode = flat)
    kept = delete(rows, where = abs(dot(@P, (1, 0, 0))) > len * 0.5 + 0.02)
    p1 = set(kept, "scale", random(lo = 0.92, hi = 1.08, rng = split_rng(rng, key = "scale")))
    p2 = set(p1, "variant", random_int(n = 3, rng = split_rng(rng, key = "var")))
    shade = random(lo = 0.7, hi = 1.25, rng = split_rng(rng, key = "tint"))
    p3 = set(p2, "tint", vec3(shade * 1.04, shade, shade * 0.96))
    p4 = set_position(p3, offset = random_vec(lo = vec3(-0.03, -0.01, -0.01), hi = vec3(0.03, 0.01, 0.07), rng = split_rng(rng, key = "jitter")))
    m = realize(instance_on_points(p4, source = a0, variants = [a0, a1, a2]))
    c1 = clip(m, origin = vec3(0.0 - len * 0.5, 0, 0), normal = vec3(1, 0, 0), cap_group = "cut")
    out = clip(c1, origin = vec3(len * 0.5, 0, 0), normal = vec3(-1, 0, 0), cap_group = "cut")
}


def grass_clump(at: vec3, rng: rng) -> (out: geo<mesh>) {
    """Пучок травы: 7 тонких вытянутых пирамидок с разбросом позиции, наклона и масштаба."""
    blade0 = compute_normals(box(size = vec3(0.05, 0.3, 0.05)), mode = flat)
    blade = transform(blade0, translate = vec3(0, 0.15, 0))
    pts0 = mesh_line(count = 7, length = 0.36, dir = (1, 0, 0))
    pts1 = transform(pts0, translate = vec3(-0.18, 0, 0))
    pts2 = set_position(pts1, offset = random_vec(lo = vec3(-0.06, 0, -0.1), hi = vec3(0.06, 0, 0.1), rng = split_rng(rng, key = "pos")))
    pts3 = set(pts2, "scale", random(lo = 0.6, hi = 1.3, rng = split_rng(rng, key = "scale")))
    pts4 = set(pts3, "orient", orient_from_euler(random_vec(lo = vec3(-28, 0, -28), hi = vec3(28, 360, 28), rng = split_rng(rng, key = "tilt"))))
    g = mark(realize(instance_on_points(pts4, source = blade)), "grass", where = true, domain = faces)
    out = transform(g, translate = at)
}

# --- производные размеры ------------------------------------------------------
uw = width + 2.0 * jetty
ud = depth + 2.0 * jetty
wall_top = stone_h + upper_h
eave_y = wall_top - 0.1
ridge_y = eave_y + uw * 0.5 + overhang
roof_t = 0.12
door_x = 0.0 - 0.75
win_x = 1.55
door_z = depth * 0.5
tf_z = ud * 0.5

root_rng = rng_from_seed(seed)
veneer_rng = split_rng(root_rng, key = "veneer")
green_rng = split_rng(root_rng, key = "green")
grass_rng = split_rng(root_rng, key = "grass")
tile_rng = split_rng(root_rng, key = "tiles")

# --- каменный первый этаж: сердцевина + кладка --------------------------------
core = piece(size = vec3(width, stone_h, depth), pos = vec3(0, stone_h * 0.5, 0), grp = "stone")
plinth = piece(size = vec3(width + 0.3, 0.32, depth + 0.3), pos = vec3(0, 0.16, 0), grp = "stone")

# Кладка: блоки трёх длин (0.5/0.55/0.6 × 0.26 × 0.1, выбор через @variant) по
# рядам вразбежку (шаг ≈0.55 подогнан под стену, ряд 0.3), per-point джиттер позиции/выступа и масштаба —
# соседние блоки то смыкаются, то оставляют шов; выступ до 0.07 даёт рельеф
# рёбер при любом шейдинге. Края — системно, через `clip` (§8.3): шаг ряда
# подогнан под длину стены (pitch = L / n), ряд генерируется с запасом на блок
# за каждый край, блоки с центром за краем не кладутся (политика «без щепок»),
# остальное подрезается плоскостями торцов — чётные ряды кончаются целым
# блоком, нечётные половинкой, как в настоящей перевязке (сдвиг 1/3 дал бы
# трети — та же схема). Стена собирается в локальной системе (x вдоль стены,
# центр в 0, z = 0.03 наружу), режется и только потом ставится на место
# (def `stone_wall`); ряды якорей — repeat-зоны (зона в def — E201).
# Проёмы: якоря под дверью, окном фасада и боковыми окнами удаляются по маске в
# локальных координатах стены — портал и рамы закрывают рваный край.
course_h = 0.3
n_rows = int(stone_h / course_h)
cols_f = int(width / 0.55)
pitch_f = width / f32(cols_f)
cols_s = int(depth / 0.55)
pitch_s = depth / f32(cols_s)
side_win_x = 0.3

anchors0 = mesh_line(count = 0, length = 0.0)
rows_f = repeat (anchors0, iterations = n_rows) |acc| {
    kf = f32(@iteration)
    odd_f = kf - 2.0 * floor(kf * 0.5)
    rf0 = mesh_line(count = cols_f + 2, length = f32(cols_f + 1) * pitch_f, dir = (1, 0, 0))
    acc = merge(acc, transform(rf0, translate = vec3(0.0 - width * 0.5 - pitch_f * 0.5 + odd_f * pitch_f * 0.5, (kf + 0.5) * course_h, 0.03)))
}
rows_s = repeat (anchors0, iterations = n_rows) |acc| {
    ks = f32(@iteration)
    odd_s = ks - 2.0 * floor(ks * 0.5)
    rs0 = mesh_line(count = cols_s + 2, length = f32(cols_s + 1) * pitch_s, dir = (1, 0, 0))
    acc = merge(acc, transform(rs0, translate = vec3(0.0 - depth * 0.5 - pitch_s * 0.5 + odd_s * pitch_s * 0.5, (ks + 0.5) * course_h, 0.03)))
}
# фасад (+Z): вырезы под арку двери и окно со ставнями; тыл (−Z): окно; бока: по окну
rows_front = delete(rows_f, where = (abs(dot(@P, (1, 0, 0)) - door_x) < 0.86 & dot(@P, (0, 1, 0)) < 2.32) | (abs(dot(@P, (1, 0, 0)) - win_x) < 0.66 & abs(dot(@P, (0, 1, 0)) - 1.45) < 0.62))
rows_back = delete(rows_f, where = abs(dot(@P, (1, 0, 0)) - 0.9) < 0.66 & abs(dot(@P, (0, 1, 0)) - 1.45) < 0.62)
rows_side = delete(rows_s, where = abs(dot(@P, (1, 0, 0)) - side_win_x) < 0.58 & abs(dot(@P, (0, 1, 0)) - 1.55) < 0.56)
wall_f = transform(stone_wall(rows_front, len = width, blk = vec3(0.5, 0.26, 0.1), rng = split_rng(veneer_rng, key = "front")), translate = vec3(0, 0, depth * 0.5))
wall_b = transform(transform(stone_wall(rows_back, len = width, blk = vec3(0.5, 0.26, 0.1), rng = split_rng(veneer_rng, key = "back")), rotate = vec3(0, 180, 0)), translate = vec3(0, 0, 0.0 - depth * 0.5))
wall_l = transform(transform(stone_wall(rows_side, len = depth, blk = vec3(0.5, 0.26, 0.1), rng = split_rng(veneer_rng, key = "left")), rotate = vec3(0, 270, 0)), translate = vec3(0.0 - width * 0.5, 0, 0))
wall_r = transform(transform(stone_wall(rows_side, len = depth, blk = vec3(0.5, 0.26, 0.1), rng = split_rng(veneer_rng, key = "right")), rotate = vec3(0, 90, 0)), translate = vec3(width * 0.5, 0, 0))
veneer = mark(merge(wall_f, wall_b, wall_l, wall_r), "stone", where = true, domain = faces)

# Угловые камни (квойны): крупные блоки столбиком на каждом углу, ориентация
# чередуется по рядам — перевязка углов, заодно прячет торцы рядов кладки.
qx = width * 0.5 + 0.04
qz = depth * 0.5 + 0.04
q0a = compute_normals(box(size = vec3(0.62, 0.27, 0.4)), mode = flat)
q0 = mark(merge(transform(q0a, translate = vec3(qx, course_h * 0.5, qz)), transform(q0a, translate = vec3(0.0 - qx, course_h * 0.5, qz)), transform(q0a, translate = vec3(qx, course_h * 0.5, 0.0 - qz)), transform(q0a, translate = vec3(0.0 - qx, course_h * 0.5, 0.0 - qz))), "stone", where = true, domain = faces)
quoins = repeat (q0, iterations = n_rows - 1) |acc| {
    k = f32(@iteration) + 1.0
    odd = k - 2.0 * floor(k * 0.5)
    qb = compute_normals(box(size = vec3(0.62 - odd * 0.22, 0.27, 0.4 + odd * 0.22)), mode = flat)
    qy = (k + 0.5) * course_h
    qa = transform(qb, translate = vec3(qx, qy, qz))
    qc = transform(qb, translate = vec3(0.0 - qx, qy, qz))
    qd = transform(qb, translate = vec3(qx, qy, 0.0 - qz))
    qe = transform(qb, translate = vec3(0.0 - qx, qy, 0.0 - qz))
    acc = merge(acc, mark(merge(qa, qc, qd, qe), "stone", where = true, domain = faces))
}

masonry = merge(core, plinth, veneer, quoins)

# --- второй этаж: штукатурка + фахверк ----------------------------------------
upper = piece(size = vec3(uw, upper_h, ud), pos = vec3(0, stone_h + upper_h * 0.5, 0), grp = "wall")

mid_y = stone_h + upper_h * 0.5
rail_y = stone_h + upper_h * 0.5
# угловые столбы
post_fl = piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(0.0 - uw * 0.5 + 0.1, mid_y, tf_z - 0.1), grp = "wood")
post_fr = piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(uw * 0.5 - 0.1, mid_y, tf_z - 0.1), grp = "wood")
post_bl = piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(0.0 - uw * 0.5 + 0.1, mid_y, 0.0 - tf_z + 0.1), grp = "wood")
post_br = piece(size = vec3(0.22, upper_h, 0.22), pos = vec3(uw * 0.5 - 0.1, mid_y, 0.0 - tf_z + 0.1), grp = "wood")
# нижние обвязки (по свесу; перекрывают верх кладки) и верхние плиты
sill_f = piece(size = vec3(uw + 0.18, 0.26, 0.28), pos = vec3(0, stone_h + 0.02, tf_z), grp = "wood")
sill_b = piece(size = vec3(uw + 0.18, 0.26, 0.28), pos = vec3(0, stone_h + 0.02, 0.0 - tf_z), grp = "wood")
sill_l = piece(size = vec3(0.28, 0.26, ud + 0.18), pos = vec3(0.0 - uw * 0.5, stone_h + 0.02, 0), grp = "wood")
sill_r = piece(size = vec3(0.28, 0.26, ud + 0.18), pos = vec3(uw * 0.5, stone_h + 0.02, 0), grp = "wood")
plate_f = piece(size = vec3(uw + 0.18, 0.2, 0.24), pos = vec3(0, wall_top - 0.1, tf_z), grp = "wood")
plate_b = piece(size = vec3(uw + 0.18, 0.2, 0.24), pos = vec3(0, wall_top - 0.1, 0.0 - tf_z), grp = "wood")
plate_l = piece(size = vec3(0.24, 0.2, ud + 0.18), pos = vec3(0.0 - uw * 0.5, wall_top - 0.1, 0), grp = "wood")
plate_r = piece(size = vec3(0.24, 0.2, ud + 0.18), pos = vec3(uw * 0.5, wall_top - 0.1, 0), grp = "wood")
# торцы балок перекрытия под свесом (фасад и тыл)
joist = piece(size = vec3(0.16, 0.16, 0.5), pos = vec3(0, 0, 0), grp = "wood")
n_joists = int(width / 0.62)
joist_len = f32(n_joists - 1) * 0.62
joist_pts0 = mesh_line(count = n_joists, length = joist_len, dir = (1, 0, 0))
joist_pts_f = transform(joist_pts0, translate = vec3(0.0 - joist_len * 0.5, stone_h - 0.19, depth * 0.5 + 0.12))
joist_pts_b = transform(joist_pts0, translate = vec3(0.0 - joist_len * 0.5, stone_h - 0.19, 0.0 - depth * 0.5 - 0.12))
joists = mark(realize(instance_on_points(merge(joist_pts_f, joist_pts_b), source = joist)), "wood", where = true, domain = faces)
# фасад: стойки по бокам большого окна, средние рельсы и раскосы в крайних панелях
stud_f1 = piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(0.0 - 0.85, mid_y, tf_z), grp = "wood")
stud_f2 = piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(0.85, mid_y, tf_z), grp = "wood")
bay = uw * 0.5 - 0.2 - 0.93
bay_c = 0.93 + bay * 0.5
rail_fl = piece(size = vec3(bay, 0.14, 0.18), pos = vec3(0.0 - bay_c, rail_y, tf_z), grp = "wood")
rail_fr = piece(size = vec3(bay, 0.14, 0.18), pos = vec3(bay_c, rail_y, tf_z), grp = "wood")
brace_len = 1.05 * 1.35
brace_fl0 = transform(piece(size = vec3(0.14, brace_len, 0.17), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 0.0 - 42))
brace_fl = transform(brace_fl0, translate = vec3(0.0 - bay_c, stone_h + upper_h * 0.25 + 0.05, tf_z))
brace_fr0 = transform(piece(size = vec3(0.14, brace_len, 0.17), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 42))
brace_fr = transform(brace_fr0, translate = vec3(bay_c, stone_h + upper_h * 0.25 + 0.05, tf_z))
brace_fl1 = transform(brace_fr0, translate = vec3(0.0 - bay_c, stone_h + upper_h * 0.75 - 0.05, tf_z))
brace_fr1 = transform(brace_fl0, translate = vec3(bay_c, stone_h + upper_h * 0.75 - 0.05, tf_z))
# тыл: стойки, рельс, раскосы
stud_b1 = piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(0.0 - 1.5, mid_y, 0.0 - tf_z), grp = "wood")
stud_b2 = piece(size = vec3(0.16, upper_h - 0.4, 0.18), pos = vec3(1.5, mid_y, 0.0 - tf_z), grp = "wood")
rail_b = piece(size = vec3(uw - 0.3, 0.14, 0.18), pos = vec3(0, rail_y, 0.0 - tf_z), grp = "wood")
brace_bl = transform(brace_fl0, translate = vec3(0.0 - bay_c - 0.2, stone_h + upper_h * 0.25 + 0.05, 0.0 - tf_z))
brace_br = transform(brace_fr0, translate = vec3(bay_c + 0.2, stone_h + upper_h * 0.25 + 0.05, 0.0 - tf_z))
# боковые стены: стойка у окна, рельс, раскосы (в плоскости YZ — поворот вокруг X)
rail_l = piece(size = vec3(0.18, 0.14, ud - 0.3), pos = vec3(0.0 - uw * 0.5, rail_y, 0), grp = "wood")
rail_r = piece(size = vec3(0.18, 0.14, ud - 0.3), pos = vec3(uw * 0.5, rail_y, 0), grp = "wood")
stud_l1 = piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(0.0 - uw * 0.5, mid_y, 0.62), grp = "wood")
stud_l2 = piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(0.0 - uw * 0.5, mid_y, 0.0 - 0.62), grp = "wood")
stud_r1 = piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(uw * 0.5, mid_y, 0.62), grp = "wood")
stud_r2 = piece(size = vec3(0.18, upper_h - 0.4, 0.16), pos = vec3(uw * 0.5, mid_y, 0.0 - 0.62), grp = "wood")
sbay = ud * 0.5 - 0.2 - 0.7
sbay_c = 0.7 + sbay * 0.5
sbrace_len = 1.05 * 1.25
sbrace_a0 = transform(piece(size = vec3(0.17, sbrace_len, 0.14), pos = (0, 0, 0), grp = "wood"), rotate = vec3(40, 0, 0))
sbrace_b0 = transform(piece(size = vec3(0.17, sbrace_len, 0.14), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0.0 - 40, 0, 0))
brace_l1 = transform(sbrace_b0, translate = vec3(0.0 - uw * 0.5, stone_h + upper_h * 0.25 + 0.05, sbay_c))
brace_l2 = transform(sbrace_a0, translate = vec3(0.0 - uw * 0.5, stone_h + upper_h * 0.25 + 0.05, 0.0 - sbay_c))
brace_r1 = transform(sbrace_b0, translate = vec3(uw * 0.5, stone_h + upper_h * 0.25 + 0.05, sbay_c))
brace_r2 = transform(sbrace_a0, translate = vec3(uw * 0.5, stone_h + upper_h * 0.25 + 0.05, 0.0 - sbay_c))

posts_all = merge(post_fl, post_fr, post_bl, post_br)
sills_all = merge(sill_f, sill_b, sill_l, sill_r)
plates_all = merge(plate_f, plate_b, plate_l, plate_r)
front_tf = merge(stud_f1, stud_f2, rail_fl, rail_fr, brace_fl, brace_fr, brace_fl1, brace_fr1)
back_tf = merge(stud_b1, stud_b2, rail_b, brace_bl, brace_br)
side_tf = merge(rail_l, rail_r, stud_l1, stud_l2, stud_r1, stud_r2, brace_l1, brace_l2, brace_r1, brace_r2)
timber = merge(posts_all, sills_all, plates_all, joists, front_tf, back_tf, side_tf)

# Фахверк фронтона (+Z): королевская стойка, воротная балка, раскосы, стойки.
apex_y = ridge_y - roof_t - 0.01
gable_z = tf_z + 0.05
gable_h = apex_y - wall_top
collar_y = wall_top + gable_h * 0.42
king = piece(size = vec3(0.18, gable_h - 0.12, 0.18), pos = vec3(0, (wall_top + apex_y) * 0.5 - 0.06, gable_z), grp = "wood")
collar_w = (apex_y - collar_y) * 2.0 - 0.3
collar = piece(size = vec3(collar_w, 0.16, 0.17), pos = vec3(0, collar_y, gable_z), grp = "wood")
gstud_l = piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(0.0 - collar_w * 0.5 + 0.35, (wall_top + collar_y) * 0.5, gable_z), grp = "wood")
gstud_r = piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(collar_w * 0.5 - 0.35, (wall_top + collar_y) * 0.5, gable_z), grp = "wood")
# Раскосы: от воротной балки вверх-внутрь к королевской стойке (40° от вертикали);
# нижний конец на балке, верхний — под коньком у стойки, целиком под скатом.
gstrut_dy = apex_y - 0.55 - collar_y - 0.08
gstrut_len = gstrut_dy / 0.76604444
gstrut_dx = gstrut_len * 0.64278761
gstrut_cx = 0.12 + gstrut_dx * 0.5
gstrut_cy = collar_y + 0.08 + gstrut_dy * 0.5
gstrut_l0 = transform(piece(size = vec3(0.13, gstrut_len, 0.15), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 0.0 - 40))
gstrut_l = transform(gstrut_l0, translate = vec3(0.0 - gstrut_cx, gstrut_cy, gable_z))
gstrut_r0 = transform(piece(size = vec3(0.13, gstrut_len, 0.15), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 40))
gstrut_r = transform(gstrut_r0, translate = vec3(gstrut_cx, gstrut_cy, gable_z))
gable_timber_f = merge(king, collar, gstud_l, gstud_r, gstrut_l, gstrut_r)
# Тыльный фронтон — королевская стойка, балка и две стойки.
king_b = piece(size = vec3(0.18, gable_h - 0.12, 0.18), pos = vec3(0, (wall_top + apex_y) * 0.5 - 0.06, 0.0 - gable_z), grp = "wood")
collar_b = piece(size = vec3(collar_w, 0.16, 0.17), pos = vec3(0, collar_y, 0.0 - gable_z), grp = "wood")
gstud_bl = piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(0.0 - collar_w * 0.5 + 0.35, (wall_top + collar_y) * 0.5, 0.0 - gable_z), grp = "wood")
gstud_br = piece(size = vec3(0.14, collar_y - wall_top - 0.1, 0.16), pos = vec3(collar_w * 0.5 - 0.35, (wall_top + collar_y) * 0.5, 0.0 - gable_z), grp = "wood")
gable_timber = merge(gable_timber_f, king_b, collar_b, gstud_bl, gstud_br)

upper_floor = merge(upper, timber, gable_timber)

# --- клумба под окном фронтона -------------------------------------------------
box_y = stone_h + 0.92
box_w = 1.7
box_d = 0.42
box_h = 0.36
fb_front = piece(size = vec3(box_w, box_h, 0.06), pos = vec3(0, box_y, tf_z + box_d - 0.03), grp = "wood")
fb_left = piece(size = vec3(0.06, box_h, box_d), pos = vec3(0.0 - box_w * 0.5 + 0.03, box_y, tf_z + box_d * 0.5), grp = "wood")
fb_right = piece(size = vec3(0.06, box_h, box_d), pos = vec3(box_w * 0.5 - 0.03, box_y, tf_z + box_d * 0.5), grp = "wood")
fb_bottom = piece(size = vec3(box_w, 0.06, box_d), pos = vec3(0, box_y - box_h * 0.5 + 0.03, tf_z + box_d * 0.5), grp = "wood")
fb_band = piece(size = vec3(box_w + 0.04, 0.07, 0.04), pos = vec3(0, box_y + 0.02, tf_z + box_d + 0.01), grp = "wood")
fb_bat1 = piece(size = vec3(0.08, box_h + 0.04, 0.08), pos = vec3(0.0 - box_w * 0.5 + 0.02, box_y, tf_z + box_d + 0.01), grp = "wood")
fb_bat2 = piece(size = vec3(0.08, box_h + 0.04, 0.08), pos = vec3(box_w * 0.5 - 0.02, box_y, tf_z + box_d + 0.01), grp = "wood")
fb_bat3 = piece(size = vec3(0.08, box_h + 0.04, 0.08), pos = vec3(0, box_y, tf_z + box_d + 0.01), grp = "wood")
fb_brk1 = transform(piece(size = vec3(0.08, 0.5, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(45, 0, 0))
fb_brk_l = transform(fb_brk1, translate = vec3(0.0 - box_w * 0.5 + 0.1, box_y - box_h * 0.5 - 0.16, tf_z + 0.18))
fb_brk_r = transform(fb_brk1, translate = vec3(box_w * 0.5 - 0.1, box_y - box_h * 0.5 - 0.16, tf_z + 0.18))
flower_box = merge(fb_front, fb_left, fb_right, fb_bottom, fb_band, fb_bat1, fb_bat2, fb_bat3, fb_brk_l, fb_brk_r)
# Зелень: облако листвы (икосферы) над ящиком, цветы — мелкие сферы поверх,
# плети — цепочки маленьких сфер, свисающие с переднего края.
leaf_src = ico_sphere(subdiv = 1, radius = 0.13)
leaf_pts0 = point_cloud(count = 70, bounds = vec3(box_w - 0.2, 0.22, box_d - 0.06), rng = split_rng(green_rng, key = "leaf_pos"))
leaf_pts1 = transform(leaf_pts0, translate = vec3(0, box_y + box_h * 0.5 + 0.1, tf_z + box_d * 0.5 + 0.03))
leaf_pts = set(leaf_pts1, "scale", random(lo = 0.7, hi = 1.4, rng = split_rng(green_rng, key = "leaf_scale")))
leaves = mark(realize(instance_on_points(leaf_pts, source = leaf_src)), "leaf", where = true, domain = faces)
flower_src = ico_sphere(subdiv = 1, radius = 0.07)
flower_pts0 = point_cloud(count = 30, bounds = vec3(box_w - 0.3, 0.14, box_d - 0.1), rng = split_rng(green_rng, key = "flower_pos"))
flower_pts1 = transform(flower_pts0, translate = vec3(0, box_y + box_h * 0.5 + 0.3, tf_z + box_d * 0.5 + 0.06))
flower_pts2 = set(flower_pts1, "scale", random(lo = 0.7, hi = 1.3, rng = split_rng(green_rng, key = "flower_scale")))
# Палитра цветов — @tint по random_int (фиолетовый / жёлтый / розовый / синий), realize кладёт его на точки.
flower_pick = random_int(n = 4, rng = split_rng(green_rng, key = "flower_color"))
flower_col = flower_pick == 0 ? vec3(0.45, 0.12, 0.7) : (flower_pick == 1 ? vec3(0.95, 0.75, 0.1) : (flower_pick == 2 ? vec3(0.9, 0.25, 0.45) : vec3(0.2, 0.35, 0.95)))
flower_pts = set(flower_pts2, "tint", flower_col)
flowers = mark(realize(instance_on_points(flower_pts, source = flower_src)), "flower", where = true, domain = faces)
vine_src = ico_sphere(subdiv = 1, radius = 0.075)
vine_a0 = mesh_line(count = 9, length = 0.85, dir = (0, -1, 0))
vine_a = transform(vine_a0, translate = vec3(0.0 - 0.62, box_y + 0.16, tf_z + box_d + 0.06))
vine_b0 = mesh_line(count = 7, length = 0.6, dir = (0, -1, 0))
vine_b = transform(vine_b0, translate = vec3(0.0 - 0.18, box_y + 0.16, tf_z + box_d + 0.06))
vine_c0 = mesh_line(count = 10, length = 1.0, dir = (0, -1, 0))
vine_c = transform(vine_c0, translate = vec3(0.3, box_y + 0.16, tf_z + box_d + 0.06))
vine_d0 = mesh_line(count = 6, length = 0.5, dir = (0, -1, 0))
vine_d = transform(vine_d0, translate = vec3(0.68, box_y + 0.16, tf_z + box_d + 0.06))
vine_pts0 = merge(vine_a, vine_b, vine_c, vine_d)
vine_pts1 = set_position(vine_pts0, offset = random_vec(lo = vec3(-0.05, -0.02, -0.03), hi = vec3(0.05, 0.02, 0.03), rng = split_rng(green_rng, key = "vine_pos")))
vine_pts = set(vine_pts1, "scale", random(lo = 0.7, hi = 1.2, rng = split_rng(green_rng, key = "vine_scale")))
vines = mark(realize(instance_on_points(vine_pts, source = vine_src)), "leaf", where = true, domain = faces)
planter = merge(flower_box, leaves, flowers, vines)

# --- крыша (локальная система: конёк вдоль X, скаты на ±Z) --------------------
rl = ud + 2.0 * overhang
sd = uw
roof_outer = gable_prism(ridge_y = ridge_y, drop = 0.0, w = rl, d = sd, floor_y = eave_y)
roof_inner = gable_prism(ridge_y = ridge_y, drop = roof_t, w = rl - 0.02, d = sd - 0.02, floor_y = eave_y - 0.5)
roof_shell = sdf_subtract(roof_outer, roof_inner)
roof_mesh = compute_normals(mesh_from_sdf(roof_shell, voxel = 0.05))
deck = mark(roof_mesh, "roof", where = true, domain = faces)

# Сланец: плоские прямоугольные плитки рядами вразбежку вверх по скату, каждый
# ряд чуть выше предыдущего (нахлёст), микро-джиттер против копланарных граней.
# Сборка локально (ряд 0 у карниза, вверх = −Z), затем поворот на ±45°.
tile_w = 0.3
tile_len = 0.42
tile_th = 0.03
col_pitch = 0.32
row_pitch = 0.28
tile = compute_normals(box(size = vec3(tile_w, tile_th, tile_len)), mode = flat)

# Края ската — как у кладки: шаг колонок подогнан под длину конька (tpitch =
# rl / n), ряд с запасом на плитку за каждым фронтоном, плитки с центром за
# краем не кладутся, остальное подрезается `clip` по фронтонам (x = ±rl/2) и
# под коньком (z = −slope_len + 0.03, конёк накрывают колпаки); у карниза
# плитка свисает намеренно.
slope_len = (sd * 0.5 + overhang) * 1.4142136
n_trows = int(slope_len / row_pitch) + 1
n_tcols = int(rl / col_pitch)
tpitch = rl / f32(n_tcols)
tanchors0 = mesh_line(count = 0, length = 0.0)
tanchors = repeat (tanchors0, iterations = n_trows) |acc| {
    kt = f32(@iteration)
    odd_t = kt - 2.0 * floor(kt * 0.5)
    row_pts0 = mesh_line(count = n_tcols + 2, length = f32(n_tcols + 1) * tpitch, dir = (1, 0, 0))
    row_pts = transform(row_pts0, translate = vec3(0.0 - rl * 0.5 - tpitch * 0.5 + odd_t * tpitch * 0.5, tile_th + kt * 0.012, 0.0 - kt * row_pitch))
    acc = merge(acc, row_pts)
}
tanchors_k = delete(tanchors, where = abs(dot(@P, (1, 0, 0))) > rl * 0.5 + 0.01)
tanchors_j = set_position(tanchors_k, offset = random_vec(lo = vec3(-0.004, -0.003, -0.004), hi = vec3(0.004, 0.003, 0.004), rng = split_rng(tile_rng, key = "jit")))
tile_shade = random(lo = 0.75, hi = 1.35, rng = split_rng(tile_rng, key = "tint"))
tanchors_t = set(tanchors_j, "tint", vec3(tile_shade * 0.97, tile_shade, tile_shade * 1.06))
slope_raw = realize(instance_on_points(tanchors_t, source = tile))
slope_c1 = clip(slope_raw, origin = vec3(0.0 - rl * 0.5, 0, 0), normal = vec3(1, 0, 0), cap_group = "cut")
slope_c2 = clip(slope_c1, origin = vec3(rl * 0.5, 0, 0), normal = vec3(-1, 0, 0), cap_group = "cut")
slope_c3 = clip(slope_c2, origin = vec3(0, 0, 0.03 - slope_len), normal = vec3(0, 0, 1), cap_group = "cut")
slope_local = mark(slope_c3, "tile", where = true, domain = faces)
eave_z = sd * 0.5 + overhang
slope_right = transform(transform(slope_local, rotate = vec3(45, 0, 0)), translate = vec3(0, eave_y + 0.02, eave_z - 0.02))
slope_left = transform(transform(transform(slope_local, rotate = vec3(0, 180, 0)), rotate = vec3(0.0 - 45, 0, 0)), translate = vec3(0, eave_y + 0.02, 0.02 - eave_z))
# Конёк: ряд плоских колпаков-уголков.
cap_src = piece(size = vec3(0.3, 0.26, 0.26), pos = (0, 0, 0), grp = "tile")
cap = transform(cap_src, rotate = vec3(45, 0, 0))
n_caps = int(rl / 0.3)
cap_len = f32(n_caps - 1) * 0.3
cap_pts0 = mesh_line(count = n_caps, length = cap_len, dir = (1, 0, 0))
cap_pts = transform(cap_pts0, translate = vec3(0.0 - cap_len * 0.5, ridge_y + 0.03, 0))
ridge_caps = mark(realize(instance_on_points(cap_pts, source = cap)), "tile", where = true, domain = faces)
# Фронтоны под кровлей (стеновой материал).
gable_sdf = gable_prism(ridge_y = ridge_y, drop = roof_t + 0.01, w = ud, d = sd - 0.02, floor_y = wall_top - 0.05)
gable_mesh = compute_normals(mesh_from_sdf(gable_sdf, voxel = 0.05))
gables = mark(gable_mesh, "wall", where = true, domain = faces)

roof_local = merge(deck, slope_right, slope_left, ridge_caps, gables)
roof = transform(roof_local, rotate = vec3(0, 90, 0))

# Ветровые доски по краям фронтонов (мир, после поворота крыши) и шпильки.
# Доска идёт от карниза до конька (+0.2 запаса у конька, где две доски сходятся):
# центр — середина ската, сдвинутая вверх по скату на 0.1.
barg_len = slope_len + 0.2
barg_cx = eave_z * 0.5 - 0.07
barg_cy = (eave_y + ridge_y) * 0.5 + 0.07 + 0.1
barg_r0 = transform(piece(size = vec3(barg_len, 0.26, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 135))
barg_rf = transform(barg_r0, translate = vec3(barg_cx, barg_cy, rl * 0.5 + 0.02))
barg_rb = transform(barg_r0, translate = vec3(barg_cx, barg_cy, 0.0 - rl * 0.5 - 0.02))
barg_l0 = transform(piece(size = vec3(barg_len, 0.26, 0.08), pos = (0, 0, 0), grp = "wood"), rotate = vec3(0, 0, 45))
barg_lf = transform(barg_l0, translate = vec3(0.0 - barg_cx, barg_cy, rl * 0.5 + 0.02))
barg_lb = transform(barg_l0, translate = vec3(0.0 - barg_cx, barg_cy, 0.0 - rl * 0.5 - 0.02))
fin_f = piece(size = vec3(0.14, 0.4, 0.14), pos = vec3(0, ridge_y + 0.22, rl * 0.5 - 0.05), grp = "wood")
fin_b = piece(size = vec3(0.14, 0.4, 0.14), pos = vec3(0, ridge_y + 0.22, 0.0 - rl * 0.5 + 0.05), grp = "wood")
barge = merge(barg_rf, barg_rb, barg_lf, barg_lb, fin_f, fin_b)

# --- труба: каменные блоки с перевязкой на правом скате ------------------------
# Сердцевина-столб плюс кладка тем же def `stone_wall`, что и стены: ряд грани
# (шаг chim_w/2, перевязка по чётности ряда) с запасом, блоки трёх длин через
# @variant, подрезка по рёбрам трубы `clip` — на углах целый/половинка.
chim_x = 1.35
chim_z = 0.0 - 0.9
chim_w = 0.84
chim_course = 0.24
chim_base = ridge_y - chim_x - 0.9
chim_top = ridge_y + 1.25
chim_n = int((chim_top - chim_base) / chim_course)
chim_core = piece(size = vec3(chim_w - 0.12, chim_top - chim_base, chim_w - 0.12), pos = vec3(chim_x, (chim_base + chim_top) * 0.5, chim_z), grp = "stone")
chim_rng = split_rng(root_rng, key = "chimney")
chim_rows0 = mesh_line(count = 0, length = 0.0)
chim_rows = repeat (chim_rows0, iterations = chim_n) |acc| {
    kc = f32(@iteration)
    odd_c = kc - 2.0 * floor(kc * 0.5)
    cr0 = mesh_line(count = 4, length = 3.0 * chim_w * 0.5, dir = (1, 0, 0))
    acc = merge(acc, transform(cr0, translate = vec3(0.0 - chim_w * 0.75 + odd_c * chim_w * 0.25, chim_base + (kc + 0.5) * chim_course, chim_w * 0.5 - 0.03)))
}
chim_blk = vec3(0.34, 0.21, 0.12)
chim_f0 = stone_wall(chim_rows, len = chim_w, blk = chim_blk, rng = split_rng(chim_rng, key = 0))
chim_f1 = stone_wall(chim_rows, len = chim_w, blk = chim_blk, rng = split_rng(chim_rng, key = 1))
chim_f2 = stone_wall(chim_rows, len = chim_w, blk = chim_blk, rng = split_rng(chim_rng, key = 2))
chim_f3 = stone_wall(chim_rows, len = chim_w, blk = chim_blk, rng = split_rng(chim_rng, key = 3))
chim_s0 = transform(chim_f0, translate = vec3(chim_x, 0, chim_z))
chim_s1 = transform(transform(chim_f1, rotate = vec3(0, 90, 0)), translate = vec3(chim_x, 0, chim_z))
chim_s2 = transform(transform(chim_f2, rotate = vec3(0, 180, 0)), translate = vec3(chim_x, 0, chim_z))
chim_s3 = transform(transform(chim_f3, rotate = vec3(0, 270, 0)), translate = vec3(chim_x, 0, chim_z))
chim_veneer = mark(merge(chim_s0, chim_s1, chim_s2, chim_s3), "stone", where = true, domain = faces)
chim_cap1 = piece(size = vec3(chim_w + 0.2, 0.14, chim_w + 0.2), pos = vec3(chim_x, chim_top + 0.07, chim_z), grp = "stone")
chim_cap2 = piece(size = vec3(chim_w - 0.1, 0.12, chim_w - 0.1), pos = vec3(chim_x, chim_top + 0.2, chim_z), grp = "stone")
chim_hole = piece(size = vec3(chim_w - 0.4, 0.14, chim_w - 0.4), pos = vec3(chim_x, chim_top + 0.28, chim_z), grp = "smoke")
chimney_all = merge(chim_core, chim_veneer, chim_cap1, chim_cap2, chim_hole)
# Дым: перекрывающиеся клубы, растут и уходят вверх-вбок змейкой, с боковыми
# отростками — читается как облако, а не как столбик шариков.
smoke_y = chim_top + 0.3
puff1 = transform(ico_sphere(subdiv = 2, radius = 0.18), translate = vec3(chim_x + 0.02, smoke_y + 0.12, chim_z))
puff2 = transform(ico_sphere(subdiv = 2, radius = 0.24), translate = vec3(chim_x - 0.14, smoke_y + 0.45, chim_z + 0.1))
puff3 = transform(ico_sphere(subdiv = 2, radius = 0.29), translate = vec3(chim_x + 0.14, smoke_y + 0.85, chim_z - 0.08))
puff3b = transform(ico_sphere(subdiv = 2, radius = 0.19), translate = vec3(chim_x - 0.24, smoke_y + 0.95, chim_z + 0.22))
puff4 = transform(ico_sphere(subdiv = 2, radius = 0.34), translate = vec3(chim_x - 0.1, smoke_y + 1.35, chim_z + 0.12))
puff4b = transform(ico_sphere(subdiv = 2, radius = 0.22), translate = vec3(chim_x + 0.4, smoke_y + 1.5, chim_z - 0.2))
puff5 = transform(ico_sphere(subdiv = 2, radius = 0.40), translate = vec3(chim_x + 0.24, smoke_y + 1.95, chim_z - 0.05))
puff5b = transform(ico_sphere(subdiv = 2, radius = 0.26), translate = vec3(chim_x - 0.3, smoke_y + 2.15, chim_z + 0.3))
smoke = mark(merge(puff1, puff2, puff3, puff3b, puff4, puff4b, puff5, puff5b), "smoke", where = true, domain = faces)

# --- дверь: арочное полотно в каменном портале, фонари, ступень ------------------
# Полотно — щит из 7 вертикальных досок прямоугольником до высоты арки: верхние
# углы прячутся за каменным кольцом портала (r_out 0.72 > диагональ угла 0.707),
# так что скруглять доски не нужно; поперёк — две планки-обвязки.
door_rng = split_rng(root_rng, key = "door")
leaf = transform(plank_panel(w = 1.0, h = 1.95, t = 0.1, n = 7, rng = door_rng), translate = vec3(door_x, 0.16 + 1.95 * 0.5, door_z + 0.08))
ring_sdf = sdf_subtract(arch_sdf(w = 1.44, straight = 1.45, r = 0.72, t = 0.22), arch_sdf(w = 1.06, straight = 1.45, r = 0.53, t = 0.3))
ring_mesh = compute_normals(mesh_from_sdf(ring_sdf, voxel = 0.03))
ring_marked = mark(ring_mesh, "stone", where = true, domain = faces)
ring = transform(ring_marked, translate = vec3(door_x, 0.1, door_z + 0.15))
ledge1 = piece(size = vec3(0.9, 0.08, 0.03), pos = vec3(door_x, 0.7, door_z + 0.15), grp = "wood")
ledge2 = piece(size = vec3(0.9, 0.08, 0.03), pos = vec3(door_x, 1.4, door_z + 0.15), grp = "wood")
door_win = piece(size = vec3(0.28, 0.28, 0.03), pos = vec3(door_x, 1.15, door_z + 0.15), grp = "glass")
door_win_f = piece(size = vec3(0.34, 0.34, 0.02), pos = vec3(door_x, 1.15, door_z + 0.145), grp = "wood")
knob = piece(size = vec3(0.07, 0.07, 0.09), pos = vec3(door_x + 0.35, 1.0, door_z + 0.17), grp = "wood")
step = piece(size = vec3(1.8, 0.16, 0.6), pos = vec3(door_x, 0.08, door_z + 0.42), grp = "stone")
lamp_l = lantern(at = vec3(door_x - 1.05, 1.72, door_z))
lamp_r = lantern(at = vec3(door_x + 1.05, 1.72, door_z))
door = merge(leaf, ring, ledge1, ledge2, door_win_f, door_win, knob, step, lamp_l, lamp_r)

# --- окна ----------------------------------------------------------------------
# Все окна со ставнями из досок (def shutter/plank_panel); первый этаж сидит в
# проёмах кладки (локальный x стены → мир по повороту yaw), ставни вынесены
# вперёд (off = 0.14) поверх выступающих камней.
win_rng = split_rng(root_rng, key = "windows")
win_g_f = place(window_sh(w = 0.9, h = 1.0, off = 0.14, rng = split_rng(win_rng, key = "gf")), yaw_deg = 0.0, at = vec3(win_x, 1.45, door_z + 0.1))
win_g_b = place(window_sh(w = 0.9, h = 1.0, off = 0.14, rng = split_rng(win_rng, key = "gb")), yaw_deg = 180.0, at = vec3(0.0 - 0.9, 1.45, 0.0 - depth * 0.5 - 0.1))
win_g_l = place(window_sh(w = 0.75, h = 0.85, off = 0.14, rng = split_rng(win_rng, key = "gl")), yaw_deg = 270.0, at = vec3(0.0 - width * 0.5 - 0.1, 1.55, side_win_x))
win_g_r = place(window_sh(w = 0.75, h = 0.85, off = 0.14, rng = split_rng(win_rng, key = "gr")), yaw_deg = 90.0, at = vec3(width * 0.5 + 0.1, 1.55, 0.0 - side_win_x))
# Второй этаж: фронтон, бока и тыл.
win_u_c = place(window_sh(w = 1.25, h = 0.95, off = 0.08, rng = split_rng(win_rng, key = "uc")), yaw_deg = 0.0, at = vec3(0, stone_h + 1.58, tf_z + 0.06))
win_u_l = place(window_sh(w = 0.85, h = 0.9, off = 0.08, rng = split_rng(win_rng, key = "ul")), yaw_deg = 270.0, at = vec3(0.0 - uw * 0.5 - 0.06, stone_h + 1.35, 0))
win_u_r = place(window_sh(w = 0.85, h = 0.9, off = 0.08, rng = split_rng(win_rng, key = "ur")), yaw_deg = 90.0, at = vec3(uw * 0.5 + 0.06, stone_h + 1.35, 0))
win_u_b = place(window_sh(w = 0.85, h = 0.9, off = 0.08, rng = split_rng(win_rng, key = "ub")), yaw_deg = 180.0, at = vec3(0, stone_h + 1.35, 0.0 - tf_z - 0.06))
windows_g = merge(win_g_f, win_g_b, win_g_l, win_g_r)
windows_u = merge(win_u_c, win_u_l, win_u_r, win_u_b)
windows = merge(windows_g, windows_u)

# --- трава у цоколя ---------------------------------------------------------------
tuft1 = grass_clump(at = vec3(0.0 - width * 0.5 + 0.5, 0, depth * 0.5 + 0.3), rng = split_rng(grass_rng, key = 1))
tuft2 = grass_clump(at = vec3(win_x + 0.2, 0, depth * 0.5 + 0.28), rng = split_rng(grass_rng, key = 2))
tuft3 = grass_clump(at = vec3(width * 0.5 + 0.3, 0, depth * 0.5 - 0.6), rng = split_rng(grass_rng, key = 3))
tuft4 = grass_clump(at = vec3(width * 0.5 + 0.28, 0, 0.0 - 1.2), rng = split_rng(grass_rng, key = 4))
tuft5 = grass_clump(at = vec3(0.0 - width * 0.5 - 0.3, 0, 0.4), rng = split_rng(grass_rng, key = 5))
tuft6 = grass_clump(at = vec3(door_x - 0.6, 0, depth * 0.5 + 0.35), rng = split_rng(grass_rng, key = 6))
grass = merge(tuft1, tuft2, tuft3, tuft4, tuft5, tuft6)

# --- сборка ----------------------------------------------------------------------
body = merge(masonry, upper_floor, planter)
top = merge(roof, barge, chimney_all, smoke)
house_raw = merge(body, top, door, windows, grass)

# --- окраска: @Cd по группам-материалам (faces) ---------------------------------
# Цвета линейные (превью применяет гамму на выходе). Камень/черепица — базовый
# цвет × per-block @tint (см. якоря) + низкочастотный fbm по мировому @P;
# цветы — @tint напрямую (палитра на якорях). Грань вне всех групп — пурпур:
# это маркер «не покрашено», а не материал.
paint_rng = split_rng(root_rng, key = "paint")
stone_col = mix(vec3(0.21, 0.18, 0.16), vec3(0.10, 0.09, 0.09), fbm(scale = 2.2, octaves = 3, rng = split_rng(paint_rng, key = "stone"))) * @tint
wall_col = mix(vec3(0.74, 0.57, 0.35), vec3(0.58, 0.44, 0.26), fbm(scale = 3.0, octaves = 3, rng = split_rng(paint_rng, key = "wall")))
tile_col = vec3(0.045, 0.05, 0.075) * @tint
leaf_col = mix(vec3(0.03, 0.17, 0.025), vec3(0.09, 0.36, 0.05), fbm(scale = 6.0, octaves = 2, rng = split_rng(paint_rng, key = "leaf")))
c1 = ingroup("stone") ? stone_col : vec3(1.0, 0.0, 1.0)
c2 = ingroup("wall") ? wall_col : c1
c3 = ingroup("wood") ? vec3(0.11, 0.055, 0.022) * @tint : c2
c4 = ingroup("glass") ? vec3(0.16, 0.22, 0.30) : c3
c5 = ingroup("lamp") ? vec3(1.0, 0.55, 0.15) : c4
c6 = ingroup("roof") ? vec3(0.035, 0.035, 0.045) : c5
c7 = ingroup("tile") ? tile_col : c6
c8 = ingroup("leaf") ? leaf_col : c7
c9 = ingroup("flower") ? @tint : c8
c10 = ingroup("grass") ? vec3(0.07, 0.28, 0.04) : c9
c11 = ingroup("smoke") ? vec3(0.55, 0.52, 0.55) : c10
house = set(house_raw, "Cd", c11, domain = faces)
output house
