{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["uvx", "blender-mcp"],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "."
      ],
      "enabled": true
    },
    "neverwhere-pgg": {
      "type": "local",
      "command": ["/bin/sh", "tools/run_pgg_mcp_server.sh"],
      "enabled": true
    }
  }
}