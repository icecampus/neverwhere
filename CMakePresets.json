{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Visual Studio 17 2022 x64",
      "binaryDir": "${sourceDir}/_intermediate_64",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg_overlays/ports",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=d:/_build"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 17 2022 x64",
      "inherits": "default"
    },
    {
      "name": "emscripten",
      "displayName": "Emscripten",
      "binaryDir": "${sourceDir}/_b-em",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/toolchain/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten"
      }
    },
    {
      "name": "ide-index",
      "displayName": "Ninja (IDE indexing only, emits compile_commands.json)",
      "binaryDir": "${sourceDir}/_intermediate_ide",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg_overlays/ports",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=d:/_build",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Xcode, arm64-osx)",
      "binaryDir": "${sourceDir}/_intermediate_64",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg_overlays/ports"
      }
    },
    {
      "name": "macos-index",
      "displayName": "macOS Ninja (IDE indexing only, emits compile_commands.json)",
      "binaryDir": "${sourceDir}/_intermediate_ide",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg_overlays/ports",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "emscripten-debug", "configurePreset": "emscripten", "configuration": "Debug" },
    { "name": "emscripten-release", "configurePreset": "emscripten", "configuration": "Release" },
    { "name": "macos-debug", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "macos-release", "configurePreset": "macos", "configuration": "Release" }
  ]
}